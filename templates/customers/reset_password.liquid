<div class="account-page">
  <div class="page-width">
    <div class="account-card">
      <p class="eyebrow">Account</p>
      <h1 class="section-title" style="font-size:2.2rem;">Reset password</h1>
      {% form 'reset_customer_password' %}
        {{ form.errors | default_errors }}
        <label>Password</label>
        <input class="field" type="password" name="customer[password]">
        <label style="margin-top:12px;">Confirm password</label>
        <input class="field" type="password" name="customer[password_confirmation]">
        <button class="btn btn-primary btn-full" type="submit" style="margin-top:16px;">Reset password</button>
      {% endform %}
    </div>
  </div>
</div>
