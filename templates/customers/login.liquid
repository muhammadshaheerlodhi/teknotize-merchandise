<div class="account-page">
  <div class="page-width">
    <div class="account-card">
      <p class="eyebrow">Account</p>
      <h1 class="section-title" style="font-size:2.4rem;">Login</h1>
      {%- if shop.checkout.guest_login -%}
        <p class="price">Have an account? Log in to check out faster.</p>
      {%- endif -%}
      {% form 'customer_login' %}
        {{ form.errors | default_errors }}
        <label for="CustomerEmail">Email</label>
        <input class="field" type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" required>
        <label for="CustomerPassword" style="margin-top:12px;">Password</label>
        <input class="field" type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password">
        <button class="btn btn-primary btn-full" type="submit" style="margin-top:16px;">Sign in</button>
      {% endform %}

      <details style="margin-top:18px;">
        <summary>Forgot password?</summary>
        {% form 'recover_customer_password' %}
          {%- if form.posted_successfully? -%}
            <p class="form-success">Check your email for reset instructions.</p>
          {%- endif -%}
          {{ form.errors | default_errors }}
          <label>Email</label>
          <input class="field" type="email" name="email" required>
          <button class="btn btn-ghost btn-full" type="submit" style="margin-top:10px;">Send reset link</button>
        {% endform %}
      </details>
      <p><a href="{{ routes.account_register_url }}">Create account</a></p>
      <p><a href="{{ settings.signup_url | default: 'https://docs.google.com/forms/d/e/1FAIpQLSfAybgtsOEkqdrP2hBMclujWAbKl5xVkAE4lx4TDgwMzffNlQ/viewform' }}" target="_blank" rel="noopener">Athlete merch sign-up</a></p>
    </div>
  </div>
</div>
