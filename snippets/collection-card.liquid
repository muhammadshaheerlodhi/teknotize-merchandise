<a class="athlete-card crystal" href="{{ collection.url }}">
  {%- if collection.image -%}
    <img
      src="{{ collection.image | image_url: width: 900 }}"
      alt="{{ collection.title | escape }}"
      width="600"
      height="750"
      loading="lazy"
    >
  {%- elsif collection.products.first.featured_image -%}
    <img
      src="{{ collection.products.first.featured_image | image_url: width: 900 }}"
      alt="{{ collection.title | escape }}"
      loading="lazy"
    >
  {%- else -%}
    <img src="{{ 'logo.png' | asset_url }}" alt="{{ collection.title | escape }}" style="object-fit:contain;background:#000;padding:40px;">
  {%- endif -%}
  <div class="card-overlay">
    <div class="card-kicker">{{ kicker | default: 'ROSTER // View Store' }}</div>
    <h3>{{ collection.title }}</h3>
    <span class="btn btn-ghost" style="min-height:36px;padding:0 14px;">Shop Storefront</span>
  </div>
</a>
