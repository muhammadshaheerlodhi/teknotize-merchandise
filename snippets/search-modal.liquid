<div class="search-modal" data-search-modal>
  <div class="search-modal-panel">
    <form action="{{ routes.search_url }}" method="get" role="search" data-athlete-search-form>
      <div class="search-modal-bar">
        <input
          type="search"
          name="q"
          data-athlete-search
          placeholder="Search athletes"
          aria-label="Search athletes"
          value="{{ search.terms | escape }}"
          autocomplete="off"
          enterkeyhint="search"
          spellcheck="false"
        >
        <button type="button" data-close-search class="search-modal-close">Close</button>
      </div>
      <div class="athlete-search-results" data-athlete-results></div>
      <p class="search-modal-copy">Type a name to find an athlete store.</p>
    </form>
  </div>
  <script type="application/json" data-athlete-index>
    [
      {%- assign athlete_first = true -%}
      {%- for collection in collections -%}
        {%- if collection.handle == 'all' or collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        {%- unless athlete_first -%},{%- endunless -%}
        {%- assign athlete_first = false -%}
        {%- liquid
          assign athlete_img = ''
          if collection.image != blank
            assign athlete_img = collection.image | image_url: width: 160
          endif
        -%}
        {"title":{{ collection.title | json }},"url":{{ collection.url | json }},"image":{{ athlete_img | json }}}
      {%- endfor -%}
    ]
  </script>
</div>
