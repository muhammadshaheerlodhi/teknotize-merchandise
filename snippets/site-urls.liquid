{%- liquid
  if settings.athlete_store_url != blank
    assign store_url = settings.athlete_store_url
  else
    assign store_url = routes.collections_url | append: '/all'
  endif

  if settings.signup_url != blank
    assign signup_url = settings.signup_url
  else
    assign signup_url = pages.signup.url | default: '/pages/signup'
  endif

  if settings.agency_url != blank
    assign agency_url = settings.agency_url
  else
    assign agency_url = pages.agency.url | default: '/pages/agency'
  endif
-%}
