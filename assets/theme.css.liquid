/* Teknotize — Premium Orange & White */
:root {
  --tm-bg: {{ settings.color_background | default: '#ffffff' }};
  --tm-bg-soft: #fff7f3;
  --tm-bg-card: #ffffff;
  --tm-bg-lift: #fff0ea;
  --tm-surface: {{ settings.color_surface | default: 'rgba(255,255,255,0.92)' }};
  --tm-text: {{ settings.color_text | default: '#1a0c0a' }};
  --tm-muted: {{ settings.color_muted | default: '#7a564c' }};
  --tm-accent: {{ settings.color_accent | default: '#FC000A' }};
  --tm-accent-2: #ff5722;
  --tm-accent-hover: #c40008;
  --tm-accent-deep: #9a0006;
  --tm-accent-soft: rgba(252, 0, 10, 0.09);
  --tm-accent-glow: rgba(252, 0, 10, 0.4);
  --tm-heading: #140808;
  --tm-orange: #ff6b2b;
  --tm-orange-soft: rgba(255, 107, 43, 0.14);
  --tm-warm-light: rgba(255, 120, 60, 0.06);
  --tm-live: {{ settings.color_live | default: '#16a34a' }};
  --tm-border: rgba(252, 0, 10, 0.1);
  --tm-border-strong: rgba(252, 0, 10, 0.18);
  --tm-glass: rgba(255, 255, 255, 0.82);
  --tm-glass-strong: rgba(255, 255, 255, 0.95);
  --tm-glass-blur: 16px;
  --tm-font-display: "Bebas Neue", "Anton", Impact, sans-serif;
  --tm-font-body: "DM Sans", "Plus Jakarta Sans", system-ui, sans-serif;
  --tm-header: 76px;
  --tm-announce: 38px;
  --tm-max: 1140px;
  --tm-gutter: clamp(1.75rem, 6vw, 5rem);
  --tm-space-sm: 12px;
  --tm-space-md: 20px;
  --tm-space-lg: 32px;
  --tm-space-xl: 48px;
  --tm-radius: 22px;
  --tm-radius-lg: 32px;
  --tm-ease: cubic-bezier(0.22, 1, 0.36, 1);
  --tm-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --tm-section-py: clamp(4.5rem, 9vw, 7.5rem);
  --tm-card-pad: clamp(24px, 3.5vw, 34px);
  --tm-section-min: min(60vh, 560px);
  --tm-shadow-glass:
    0 1px 0 rgba(255, 255, 255, 0.95) inset,
    0 8px 40px rgba(252, 0, 10, 0.07),
    0 2px 12px rgba(26, 12, 10, 0.04);
  --tm-shadow-card: 0 12px 48px rgba(252, 0, 10, 0.1);
}

*, *::before, *::after { box-sizing: border-box; }

img, video {
  max-width: 100%;
  height: auto;
}

.roster, .shop-categories, .engine, .about-block, .mission, .partners-block, .testimonials, .faq, .contact-block, .signup-block, .athlete-stores {
  content-visibility: auto;
  contain-intrinsic-size: auto 480px;
}

#home, #why-teknotize, #reviews, #contact, #faq, #mission, #signup {
  scroll-margin-top: 96px;
}

html { scroll-behavior: smooth; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--tm-bg);
  color: var(--tm-text);
  font-family: var(--tm-font-body);
  font-size: 16px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  overscroll-behavior-y: contain;
}

body {
  background-image:
    radial-gradient(ellipse 90% 60% at 50% -15%, rgba(252, 0, 10, 0.12), transparent 55%),
    radial-gradient(ellipse 50% 40% at 100% 20%, rgba(255, 107, 43, 0.1), transparent 50%),
    radial-gradient(ellipse 45% 35% at 0% 70%, rgba(252, 0, 10, 0.06), transparent 50%),
    linear-gradient(180deg, #fff9f6 0%, var(--tm-bg) 35%, #fffaf8 100%);
  background-attachment: scroll;
}

img, svg, video { max-width: 100%; display: block; height: auto; }

a {
  color: inherit;
  text-decoration: none;
  transition: color 0.2s var(--tm-ease);
}

button, input, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; background: none; border: 0; }

h1, h2, h3, h4, .display {
  font-family: var(--tm-font-display);
  font-weight: 400;
  letter-spacing: 0.04em;
  line-height: 1.02;
  text-transform: uppercase;
  margin: 0;
}

p { margin: 0 0 1.15rem; }

p:last-child { margin-bottom: 0; }

.skip-link {
  position: absolute; left: -999px; top: 0;
  background: var(--tm-accent); color: #fff;
  padding: 0.6rem 1rem; z-index: 10000; border-radius: 8px;
}
.skip-link:focus { left: 8px; top: 8px; }

.visually-hidden {
  position: absolute !important; overflow: hidden;
  width: 1px; height: 1px; margin: -1px; padding: 0; border: 0;
  clip: rect(0 0 0 0);
}

.page-width {
  width: min(var(--tm-max), 100%);
  margin-inline: auto;
  padding-inline: var(--tm-gutter);
}

.main-content {
  overflow-x: clip;
  overflow-y: visible;
}

/* Crystal glass panel — premium athlete-store cards */
.crystal {
  position: relative;
  overflow: hidden;
  background: linear-gradient(
    155deg,
    rgba(255, 255, 255, 0.98) 0%,
    rgba(255, 250, 247, 0.96) 55%,
    rgba(255, 242, 238, 0.94) 100%
  );
  border: 1px solid rgba(252, 0, 10, 0.1);
  box-shadow:
    0 1px 0 rgba(255, 255, 255, 1) inset,
    0 12px 32px rgba(252, 0, 10, 0.05),
    0 4px 12px rgba(26, 12, 10, 0.04);
  transition:
    transform 0.2s var(--tm-ease-out),
    box-shadow 0.2s var(--tm-ease-out),
    border-color 0.2s var(--tm-ease-out);
}

.site-header.crystal,
.mobile-drawer.crystal {
  backdrop-filter: blur(12px) saturate(150%);
  -webkit-backdrop-filter: blur(12px) saturate(150%);
}

.crystal::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--tm-accent), transparent);
  opacity: 0.55;
  pointer-events: none;
}

.crystal:hover {
  transform: translateY(-6px);
  border-color: rgba(252, 0, 10, 0.24);
  box-shadow:
    0 1px 0 rgba(255, 255, 255, 1) inset,
    0 28px 60px rgba(252, 0, 10, 0.14),
    0 10px 28px rgba(26, 12, 10, 0.07);
}

.card-icon {
  display: grid;
  place-items: center;
  width: 52px;
  height: 52px;
  border-radius: 16px;
  font-size: 1.35rem;
  margin-bottom: 18px;
  background: linear-gradient(145deg, rgba(252, 0, 10, 0.14), rgba(252, 0, 10, 0.04));
  border: 1px solid rgba(252, 0, 10, 0.2);
  box-shadow: 0 8px 24px rgba(252, 0, 10, 0.1);
  transition: transform 0.28s var(--tm-ease-out);
}

.crystal:hover .card-icon {
  transform: scale(1.08) rotate(-3deg);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 16px 0 20px;
}

.tag-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--tm-accent);
  background: rgba(252, 0, 10, 0.06);
  border: 1px solid rgba(252, 0, 10, 0.14);
}

.reveal-stagger > * {
  opacity: 1;
  transform: none;
  transition:
    opacity 0.14s var(--tm-ease-out),
    transform 0.14s var(--tm-ease-out);
}

.reveal-stagger.is-visible > * {
  opacity: 1;
  transform: none;
}

.reveal-stagger.is-visible > *:nth-child(n) { transition-delay: 0s; }

/* Scroll reveal — visible by default so homepage is never blank if JS fails */
.reveal {
  opacity: 1;
  transform: none;
  transition:
    opacity 0.14s var(--tm-ease-out),
    transform 0.14s var(--tm-ease-out);
}
.reveal.is-visible {
  opacity: 1;
  transform: none;
  will-change: auto;
}

.no-js .reveal,
.no-js .reveal-stagger > * {
  opacity: 1;
  transform: none;
}

.reveal-left {
  transform: translate3d(-20px, 0, 0) scale(0.98);
}
.reveal-right {
  transform: translate3d(20px, 0, 0) scale(0.98);
}
.reveal-scale {
  transform: scale(0.94);
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--tm-accent);
  margin-bottom: var(--tm-space-md);
  padding: 8px 16px;
  border-radius: 999px;
  background: rgba(252, 0, 10, 0.06);
  border: 1px solid rgba(252, 0, 10, 0.18);
  backdrop-filter: blur(8px);
}

.lede {
  color: var(--tm-muted);
  font-size: 1.08rem;
  max-width: 54ch;
  line-height: 1.8;
  margin-bottom: var(--tm-space-lg);
}

.section-intro {
  margin-bottom: var(--tm-space-xl);
  max-width: 720px;
}

.section-intro--center {
  margin-inline: auto;
  text-align: center;
}

.section-intro--center .lede {
  margin-inline: auto;
}

/* About / info cards */
.about-block .about-grid,
.about-layout {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(18px, 3vw, 24px);
  margin-top: var(--tm-space-lg);
}

.info-card {
  padding: var(--tm-card-pad);
  height: 100%;
  display: flex;
  flex-direction: column;
}

.info-card .eyebrow { margin-bottom: 14px; }

.info-card h3,
.info-card h2 {
  font-size: clamp(1.25rem, 2.5vw, 1.45rem);
  margin: 0 0 14px;
  color: var(--tm-heading);
  line-height: 1.05;
}

.info-card p {
  color: var(--tm-muted);
  font-size: 0.94rem;
  line-height: 1.75;
  margin: 0;
  flex: 1;
}

/* Testimonials marquee */
.testimonials {
  overflow: hidden;
}

.reviews-marquee {
  position: relative;
  overflow: hidden;
  margin-top: var(--tm-space-md);
  padding: 10px 0 18px;
  mask-image: linear-gradient(90deg, transparent 0%, #000 6%, #000 94%, transparent 100%);
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 6%, #000 94%, transparent 100%);
}

.reviews-marquee::before,
.reviews-marquee::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  width: 48px;
  z-index: 2;
  pointer-events: none;
}

.reviews-marquee::before {
  left: 0;
  background: linear-gradient(90deg, var(--tm-bg) 0%, transparent 100%);
}

.reviews-marquee::after {
  right: 0;
  background: linear-gradient(270deg, var(--tm-bg) 0%, transparent 100%);
}

.reviews-track {
  display: flex;
  align-items: stretch;
  gap: clamp(16px, 2.5vw, 22px);
  width: max-content;
  animation: reviewsScroll 38s linear infinite;
}

.reviews-marquee.is-paused .reviews-track {
  animation-play-state: paused;
}

.reviews-marquee:hover .reviews-track {
  animation-play-state: paused;
}

@keyframes reviewsScroll {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(-50%, 0, 0); }
}

.review-card {
  flex: 0 0 min(320px, 84vw);
  min-height: 260px;
  padding: var(--tm-card-pad);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.review-head {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.review-avatar {
  width: 44px;
  height: 44px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  font-family: var(--tm-font-display);
  font-size: 1rem;
  color: #fff;
  background: linear-gradient(145deg, var(--tm-accent), #c40008);
  border: 2px solid rgba(255, 255, 255, 0.85);
  flex-shrink: 0;
}

.review-meta strong {
  display: block;
  font-size: 13px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--tm-heading);
}

.review-role {
  display: block;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--tm-accent);
  margin-top: 2px;
}

.review-card .stars {
  color: #f59e0b;
  letter-spacing: 3px;
  margin-bottom: 16px;
  font-size: 14px;
}

.review-card p {
  color: var(--tm-text);
  font-size: 0.95rem;
  line-height: 1.75;
  margin: 0 0 18px;
  flex: 1;
}

.review-card > strong:last-child { display: none; }

.review-grid {
  display: none;
}

/* Contact */
.contact-layout {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  gap: clamp(22px, 4vw, 36px);
  align-items: start;
  margin-top: var(--tm-space-lg);
}

.contact-stack {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.contact-stack .info-card {
  min-height: auto;
}

.signup-panel {
  padding: var(--tm-card-pad);
  border-radius: var(--tm-radius-lg);
}

/* Footer social */
.footer-social-block {
  margin-top: 22px;
}

.footer-social-block h4 {
  font-family: var(--tm-font-body);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  margin-bottom: 14px;
  color: var(--tm-heading);
}

.socials {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 0;
}

.socials a {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  border: 1px solid rgba(252, 0, 10, 0.14);
  background: rgba(255, 255, 255, 0.92);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--tm-heading);
  transition:
    transform 0.22s var(--tm-ease-out),
    border-color 0.22s,
    background 0.22s,
    color 0.22s,
    box-shadow 0.22s;
}

.socials a:hover {
  border-color: rgba(196, 0, 8, 0.4);
  background: rgba(252, 0, 10, 0.08);
  color: var(--tm-accent);
  transform: translateY(-3px);
  box-shadow: 0 10px 24px rgba(252, 0, 10, 0.14);
}

.partner-card .btn { margin-top: auto; align-self: flex-start; }

.partner-card {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.live-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--tm-live);
  box-shadow: 0 0 10px rgba(34, 197, 94, 0.7);
  animation: pulse 1.4s ease infinite;
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); transform: scale(1); }
  70% { box-shadow: 0 0 0 8px rgba(34, 197, 94, 0); transform: scale(1.08); }
}

@keyframes marquee {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(-50%, 0, 0); }
}

@keyframes shimmer {
  from { background-position: 200% center; }
  to { background-position: -200% center; }
}

@keyframes floatY {
  0%, 100% { transform: translate3d(0, 0, 0); }
  50% { transform: translate3d(0, -10px, 0); }
}

@keyframes ringPulse {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 0.85; transform: scale(1.06); }
}

@keyframes blink {
  50% { opacity: 0; }
}

@keyframes glowPulse {
  0%, 100% { text-shadow: 0 0 20px rgba(252, 0, 10, 0.35); }
  50% { text-shadow: 0 0 32px rgba(252, 0, 10, 0.65); }
}

@keyframes shineSweep {
  from { transform: translateX(-120%) skewX(-12deg); }
  to { transform: translateX(220%) skewX(-12deg); }
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 50px;
  padding: 0 28px;
  border-radius: 999px;
  font-family: var(--tm-font-body);
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border: 1px solid transparent;
  transition:
    transform 0.25s var(--tm-ease-out),
    box-shadow 0.25s var(--tm-ease-out),
    border-color 0.25s,
    background 0.25s,
    color 0.25s;
}

.btn:hover { transform: translateY(-4px); }
.btn:active { transform: translateY(-1px); }

.btn-primary {
  background: linear-gradient(135deg, #FC000A 0%, #e8000a 45%, #d40009 100%);
  background-size: 200% auto;
  color: #fff;
  box-shadow: 0 6px 24px rgba(252, 0, 10, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  position: relative;
  overflow: hidden;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #e00009 0%, #c40008 50%, #9a0006 100%);
  box-shadow:
    0 10px 36px rgba(180, 0, 7, 0.55),
    0 0 0 3px rgba(252, 0, 10, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
  transform: translateY(-4px);
}

.btn-primary::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,0.25) 50%, transparent 65%);
  transform: translateX(-120%);
  transition: transform 0.5s var(--tm-ease);
}

.btn-primary:hover::after {
  transform: translateX(120%);
  transition: transform 0.45s var(--tm-ease);
}

.btn-ghost {
  color: var(--tm-heading);
  border-color: rgba(252, 0, 10, 0.16);
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(14px);
  box-shadow: 0 4px 16px rgba(252, 0, 10, 0.04);
}

.btn-ghost:hover {
  border-color: rgba(196, 0, 8, 0.45);
  background: linear-gradient(135deg, rgba(252, 0, 10, 0.1), rgba(255, 107, 43, 0.08));
  color: var(--tm-accent-hover);
  box-shadow:
    0 10px 28px rgba(180, 0, 7, 0.18),
    0 0 0 3px rgba(252, 0, 10, 0.08);
}

.btn-xl {
  min-height: 58px;
  padding: 0 40px;
  font-size: 13px;
  letter-spacing: 0.12em;
}

.btn-full { width: 100%; }

/* Logo — wordmark only (no image background) */
.logo-text {
  display: flex;
  flex-direction: column;
  font-family: var(--tm-font-display);
  font-size: clamp(1.35rem, 3.5vw, 1.65rem);
  letter-spacing: 0.14em;
  color: var(--tm-heading);
  line-height: 0.88;
  transition: color 0.18s var(--tm-ease), text-shadow 0.18s;
}

.logo-text strong {
  font-weight: 400;
  color: var(--tm-accent);
  text-shadow: 0 0 18px var(--tm-accent-glow);
}

.logo-text small {
  font-size: 0.42em;
  letter-spacing: 0.32em;
  color: var(--tm-muted);
  margin-top: 2px;
}

.header-logo:hover .logo-text,
.footer-logo:hover .logo-text {
  color: var(--tm-heading);
}

.header-logo:hover .logo-text strong,
.footer-logo:hover .logo-text strong {
  color: var(--tm-accent-hover);
  text-shadow: 0 0 24px var(--tm-accent-glow);
}

.header-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

/* Keep announcement + header stuck on desktop and mobile. */
#shopify-section-group-header-group,
.shopify-section-group-header-group {
  position: sticky;
  top: 0;
  z-index: 80;
  background: #fff;
}

/* Header */
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #fff;
  border-bottom: 1px solid rgba(252, 0, 10, 0.08);
  box-shadow: 0 8px 32px rgba(252, 0, 10, 0.05);
}

.header-inner {
  min-height: var(--tm-header);
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: clamp(12px, 2vw, 24px);
  padding-block: 8px;
}

.header-nav {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: nowrap;
  gap: 2px;
  min-width: 0;
}

.header-nav a:not(.btn) {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--tm-muted);
  padding: 8px 11px;
  border-radius: 999px;
  border: 1px solid transparent;
  white-space: nowrap;
  transition:
    color 0.22s,
    background 0.22s,
    box-shadow 0.22s,
    border-color 0.22s,
    transform 0.22s;
}

.header-nav a:not(.btn):hover {
  color: var(--tm-accent);
  background: rgba(255, 255, 255, 0.9);
  border-color: rgba(252, 0, 10, 0.12);
  box-shadow: 0 6px 20px rgba(252, 0, 10, 0.08);
  transform: translateY(-1px);
}

.header-nav a.is-active {
  color: var(--tm-accent);
  background: rgba(252, 0, 10, 0.07);
  border: 1px solid rgba(252, 0, 10, 0.18);
  box-shadow: 0 6px 20px rgba(252, 0, 10, 0.08);
}

.header-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  flex-shrink: 0;
}

.icon-btn {
  position: relative;
  z-index: 2;
  width: 44px; height: 44px;
  display: grid; place-items: center;
  touch-action: manipulation;
  border-radius: 999px;
  border: 1px solid rgba(252, 0, 10, 0.12);
  background: rgba(255, 255, 255, 0.92);
  color: var(--tm-heading);
  transition:
    border-color 0.22s,
    background 0.22s,
    transform 0.22s,
    color 0.22s,
    box-shadow 0.22s;
}

.icon-btn:hover {
  border-color: rgba(196, 0, 8, 0.35);
  background: rgba(252, 0, 10, 0.06);
  color: var(--tm-accent);
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(252, 0, 10, 0.12);
}

.header-signup {
  min-height: 38px;
  padding: 0 16px;
  font-size: 10px;
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.logo-img {
  display: block;
  width: var(--logo-width, 112px);
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 4px 14px rgba(252, 0, 10, 0.18));
  transition: transform 0.22s var(--tm-ease), filter 0.22s var(--tm-ease);
}

.header-logo:hover .logo-img,
.footer-logo:hover .logo-img {
  transform: scale(1.03);
  filter: drop-shadow(0 6px 18px rgba(252, 0, 10, 0.28));
}

.footer-logo .logo-img { width: min(var(--logo-width, 112px), 100px); }

.header-logo .logo-text { font-size: clamp(1.2rem, 2.8vw, 1.5rem); }

.desktop-only { display: inline-flex; }

.cart-count {
  position: absolute; top: 2px; right: 2px;
  min-width: 16px; height: 16px;
  border-radius: 999px;
  background: var(--tm-accent);
  font-size: 9px; font-weight: 700;
  display: grid; place-items: center;
  color: #fff;
}

.menu-toggle, .mobile-only { display: none; }

@media (max-width: 1180px) {
  .header-nav a:not(.btn) {
    padding: 7px 9px;
    font-size: 9px;
    letter-spacing: 0.06em;
  }

  .header-signup.desktop-only {
    padding: 0 14px;
    min-height: 36px;
  }
}
.mobile-nav,
.mobile-drawer { display: none; }

/* Announcement */
.announcement {
  height: var(--tm-announce);
  overflow: hidden;
  background: linear-gradient(90deg, var(--tm-accent), #e8000a);
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
}

.announcement-track {
  display: flex;
  gap: 40px;
  height: 100%;
  align-items: center;
  white-space: nowrap;
  min-width: max-content;
  animation: marquee 16s linear infinite;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: #fff;
}

.announcement-track span:nth-child(odd) { color: rgba(255, 255, 255, 0.85); }

/* Hero */
.hero {
  position: relative;
  padding: clamp(2.5rem, 5vw, 4rem) 0;
  min-height: auto;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hero::before {
  content: "";
  position: absolute;
  top: -15%; right: 5%;
  width: min(380px, 55vw); height: min(380px, 55vw);
  background: radial-gradient(circle, rgba(252, 0, 10, 0.1), transparent 65%);
  pointer-events: none;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 380px);
  gap: clamp(28px, 5vw, 56px);
  align-items: center;
}

.hero h1 {
  font-size: clamp(2.4rem, 5.5vw, 4.2rem);
  margin: 12px 0 20px;
  color: var(--tm-heading);
}

.hero h1 .cursor {
  color: var(--tm-accent);
  animation: blink 0.85s steps(1) infinite;
  text-shadow: 0 0 24px var(--tm-accent-glow);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin: var(--tm-space-lg) 0 var(--tm-space-md);
}

.hero-copy {
  color: var(--tm-muted);
  max-width: 48ch;
  font-size: 0.98rem;
}

.hero-media {
  position: relative;
  width: 100%;
  max-width: 400px;
  margin-left: auto;
}

/* Hero art — no box, black bg removed via screen blend + PNG optional */
.hero-image-frame {
  position: relative;
  overflow: visible;
  background: transparent;
  border: 0;
  box-shadow: none;
  aspect-ratio: auto;
  max-height: none;
  padding: 0;
}

.hero-image-frame.crystal {
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border: 0;
  box-shadow: none;
}

.hero-image-frame:hover {
  transform: none;
  box-shadow: none;
}

.hero-image-frame img,
.hero-art-img,
.hero-art-video {
  width: 100%;
  max-width: min(380px, 100%);
  height: auto;
  display: block;
  margin-inline: auto;
  object-fit: contain;
  filter: drop-shadow(0 16px 40px rgba(252, 0, 10, 0.22));
  transition: transform 0.28s var(--tm-ease), filter 0.28s var(--tm-ease);
}

.hero-art-video {
  border-radius: 18px;
  background: #140808;
}

/* Embedded players only expose an iframe, so the frame owns the aspect ratio. */
.hero-art-embed {
  position: relative;
  width: 100%;
  max-width: min(380px, 100%);
  aspect-ratio: 9 / 11;
  margin-inline: auto;
  border-radius: 18px;
  overflow: hidden;
  background: #140808;
  filter: drop-shadow(0 16px 40px rgba(252, 0, 10, 0.22));
  transition: transform 0.28s var(--tm-ease), filter 0.28s var(--tm-ease);
}

.hero-art-poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  pointer-events: none;
}

.hero-art-embed iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  display: block;
  z-index: 1;
}

.hero-image-frame:hover .hero-art-embed {
  transform: translateY(-4px) scale(1.02);
  filter: drop-shadow(0 22px 48px rgba(252, 0, 10, 0.32));
}

.hero-image-frame:hover img,
.hero-image-frame:hover .hero-art-img,
.hero-image-frame:hover .hero-art-video {
  transform: translateY(-4px) scale(1.02);
  filter: drop-shadow(0 22px 48px rgba(252, 0, 10, 0.32));
}

.hero-badge {
  position: absolute;
  bottom: 8px;
  left: 8px;
  z-index: 2;
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid rgba(252, 0, 10, 0.28);
  color: var(--tm-accent);
}

.hero-float {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 2;
  padding: 8px 14px;
  border-radius: 999px;
  font-family: var(--tm-font-display);
  font-size: 0.95rem;
  letter-spacing: 0.06em;
  background: linear-gradient(145deg, #FC000A, #c40008);
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: #fff;
  box-shadow: 0 6px 20px rgba(252, 0, 10, 0.35);
}

/* Athlete Stores — redirect spotlight (no grid on homepage) */
.athlete-stores {
  padding: var(--tm-section-py) 0;
  background: linear-gradient(180deg, var(--tm-bg-soft) 0%, var(--tm-bg) 100%);
}

.stores-cta-panel {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: clamp(24px, 4vw, 48px);
  align-items: center;
  padding: clamp(32px, 5vw, 56px);
  border-radius: calc(var(--tm-radius-lg) + 4px);
  position: relative;
  overflow: hidden;
}

.stores-cta-panel::after {
  content: "";
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 280px;
  height: 280px;
  background: radial-gradient(circle, rgba(252, 0, 10, 0.08), transparent 70%);
  pointer-events: none;
}

.stores-cta-panel::before {
  content: "";
  position: absolute;
  top: -40%; right: -20%;
  width: 420px; height: 420px;
  background: radial-gradient(circle, rgba(252, 0, 10, 0.14), transparent 65%);
  pointer-events: none;
}

.stores-cta-content { position: relative; z-index: 1; }

.stores-cta-content .section-title {
  margin-bottom: 14px;
  animation: none;
}

.stores-cta-stats {
  display: none;
}

.stores-stat {
  padding: 14px 20px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(252, 0, 10, 0.1);
  min-width: 108px;
  transition: transform 0.25s var(--tm-ease-out), box-shadow 0.25s;
}

.stores-stat:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 28px rgba(252, 0, 10, 0.1);
}

.stores-stat strong {
  display: block;
  font-family: var(--tm-font-display);
  font-size: 1.8rem;
  color: var(--tm-accent);
  line-height: 1;
  letter-spacing: 0.04em;
}

.stores-stat span {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--tm-muted);
}

.stores-cta-visual {
  position: relative;
  z-index: 1;
  border-radius: var(--tm-radius);
  overflow: hidden;
  aspect-ratio: 4 / 3;
  box-shadow: var(--tm-shadow-card);
}

.stores-cta-visual img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.stores-cta-visual::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(252, 0, 10, 0.15), transparent 55%);
  pointer-events: none;
}

.stores-cta-badge {
  position: absolute;
  bottom: 16px; left: 16px;
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  background: #fff;
  color: var(--tm-accent);
  border: 1px solid var(--tm-border);
  z-index: 2;
}

.athlete-stores-header { margin-bottom: 28px; }

.store-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
  padding: 14px 16px;
  border-radius: var(--tm-radius);
}

.store-search {
  flex: 1;
  min-width: 200px;
  padding: 12px 16px;
  border-radius: 12px;
  border: 1px solid var(--tm-border);
  background: rgba(255, 255, 255, 0.95);
  color: var(--tm-heading);
}

.store-search::placeholder { color: var(--tm-muted); }
.store-search:focus {
  outline: none;
  border-color: rgba(252, 0, 10, 0.45);
  box-shadow: 0 0 0 3px rgba(252, 0, 10, 0.12);
}

.store-count {
  margin-left: auto;
  font-size: 12px;
  font-weight: 600;
  color: var(--tm-muted);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.filter-chip {
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border: 1px solid var(--tm-border);
  background: var(--tm-glass);
  color: var(--tm-muted);
  transition: all 0.2s var(--tm-ease);
}

.filter-chip:hover,
.filter-chip.is-active {
  border-color: rgba(252, 0, 10, 0.45);
  background: var(--tm-accent-soft);
  color: var(--tm-accent);
}

.no-results {
  display: none;
  text-align: center;
  padding: 32px;
  color: var(--tm-muted);
}

.no-results.is-visible { display: block; }

/* Sections shared */
.section-label {
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--tm-muted);
  margin-bottom: var(--tm-space-sm);
  font-weight: 600;
}

.section-title {
  font-size: clamp(2rem, 4.2vw, 3.2rem);
  margin-bottom: var(--tm-space-md);
  color: var(--tm-heading);
  position: relative;
  display: inline-block;
}

.section-title::after {
  content: "";
  display: block;
  width: 56px;
  height: 4px;
  margin-top: 12px;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--tm-accent), rgba(252, 0, 10, 0.15));
}

.section-intro--center .section-title::after {
  margin-inline: auto;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.roster, .engine, .shop-categories, .featured-products,
.about-block, .mission, .partners-block, .testimonials,
.contact-block, .signup-block,
.featured-athletes, .main-collection, .main-product,
.main-cart, .main-search, .main-page, .list-collections,
.account-page {
  padding: var(--tm-section-py) 0;
  min-height: auto;
}

.featured-athletes, .main-collection,
.main-search, .main-page, .list-collections,
.account-page {
  content-visibility: auto;
  contain-intrinsic-size: auto 480px;
}

.roster, .engine, .mission, .testimonials {
  min-height: auto;
}

/* Stats */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(18px, 3vw, 24px);
  margin-top: var(--tm-space-lg);
}

.stat-card {
  border-radius: var(--tm-radius-lg);
  padding: clamp(24px, 3vw, 32px);
  min-height: auto;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  transition: transform 0.28s var(--tm-ease), box-shadow 0.28s;
}

.stat-card .card-icon {
  width: 48px;
  height: 48px;
  font-size: 1.2rem;
  margin-bottom: 14px;
}

.stat-card:hover {
  transform: translateY(-4px);
  box-shadow:
    0 1px 0 rgba(255, 255, 255, 1) inset,
    0 16px 48px rgba(252, 0, 10, 0.12);
}

.stat-live {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--tm-live);
  margin-bottom: 12px;
}

.stat-card > p:first-of-type {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--tm-muted);
  margin-bottom: 6px;
}

.stat-card h3 {
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  margin-bottom: 10px;
  color: var(--tm-heading);
  background: linear-gradient(135deg, var(--tm-accent), #ff6b2b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-card p:last-child { color: var(--tm-muted); margin: 0; font-size: 0.88rem; line-height: 1.6; }

/* How it works — premium numbers */
.stages {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: clamp(18px, 3vw, 24px);
  margin-top: var(--tm-space-lg);
}

.stage {
  border-radius: var(--tm-radius-lg);
  padding: clamp(24px, 3vw, 32px);
  min-height: 260px;
  display: flex;
  flex-direction: column;
  transition: transform 0.28s var(--tm-ease), box-shadow 0.28s;
}

.stage:hover { transform: translateY(-5px); }

.stage .card-icon {
  width: 56px;
  height: 56px;
  border-radius: 18px;
  margin-bottom: 16px;
}

.stage-num,
.stage small {
  display: none;
}

.stage h3 {
  font-size: 1.35rem;
  margin-bottom: 10px;
  color: var(--tm-heading);
}

.stage p { color: var(--tm-muted); margin: 0; font-size: 0.92rem; line-height: 1.65; }

/* Grids */
.athlete-grid, .product-grid, .category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(14px, 2.5vw, 20px);
}

.athlete-card, .product-card, .category-card {
  position: relative;
  overflow: hidden;
  border-radius: calc(var(--tm-radius) + 2px);
  min-height: 300px;
  border: 1px solid rgba(252, 0, 10, 0.08);
  box-shadow: 0 16px 40px rgba(252, 0, 10, 0.08);
  transition: transform 0.32s var(--tm-ease), box-shadow 0.32s var(--tm-ease);
}

.athlete-card::after, .category-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.12) 50%, transparent 60%);
  transform: translateX(-120%) skewX(-8deg);
  pointer-events: none;
  transition: transform 0.6s var(--tm-ease);
}

.athlete-card:hover::after, .category-card:hover::after {
  transform: translateX(120%) skewX(-8deg);
}

.athlete-card:hover, .product-card:hover, .category-card:hover {
  transform: translateY(-6px) scale(1.01);
  box-shadow: var(--tm-shadow-card);
}

.athlete-card img, .product-card img, .category-card img {
  width: 100%;
  height: 100%;
  min-height: 300px;
  object-fit: cover;
  transition: transform 0.4s var(--tm-ease);
}

.athlete-card:hover img, .product-card:hover img, .category-card:hover img { transform: scale(1.05); }

.category-visual {
  height: 200px;
  background: linear-gradient(135deg, rgba(252, 0, 10, 0.25), rgba(30, 20, 18, 0.9));
}

.card-overlay {
  position: absolute;
  inset: auto 0 0;
  padding: 20px 18px 18px;
  background: linear-gradient(transparent 0%, rgba(8, 6, 6, 0.88) 45%, rgba(8, 6, 6, 0.96) 100%);
}

.category-card .card-overlay p {
  color: rgba(255, 255, 255, 0.75);
  font-size: 0.82rem;
  margin: 6px 0 0;
  line-height: 1.5;
}

.card-kicker {
  font-size: 9px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--tm-accent);
  font-weight: 700;
}

.card-overlay h3 {
  font-size: 1.2rem;
  margin: 4px 0 0;
  color: #fff;
}

.product-card { min-height: 0; }
.product-card .media {
  background: #fff;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.product-card .media img {
  min-height: 0;
  height: 100%;
  width: 100%;
  object-fit: contain;
  padding: 18px;
}
.product-card .card-body { padding: 14px 16px 18px; }

.product-card h3 {
  font-family: var(--tm-font-body);
  text-transform: none;
  letter-spacing: 0;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.35;
  color: var(--tm-heading);
}

.price { color: var(--tm-muted); font-size: 14px; font-weight: 600; }
.price-sale { color: var(--tm-accent); }
.compare { text-decoration: line-through; opacity: 0.5; margin-left: 6px; }

/* Circle hover cards — mission & about */
.orbit-cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(24px, 3.5vw, 40px);
  margin-top: var(--tm-space-xl);
  max-width: 1140px;
  margin-inline: auto;
}

.about-block .orbit-cards {
  max-width: 1080px;
}

.mission .orbit-cards {
  max-width: 1140px;
}

.orbit-card {
  width: 100%;
  max-width: 340px;
  aspect-ratio: 1;
  margin-inline: auto;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  cursor: default;
  border: 3px solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 20px 48px rgba(252, 0, 10, 0.14),
    0 8px 24px rgba(26, 12, 10, 0.08);
  transition: transform 0.22s var(--tm-ease-out), box-shadow 0.22s var(--tm-ease-out);
}

a.orbit-card {
  cursor: pointer;
  text-decoration: none;
  color: inherit;
}

.orbit-card.crystal {
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.orbit-card.crystal::before {
  display: none;
}

.orbit-card.crystal:hover {
  transform: scale(1.04);
  box-shadow:
    0 28px 56px rgba(252, 0, 10, 0.2),
    0 12px 28px rgba(26, 12, 10, 0.1);
}

.orbit-card-media {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  overflow: hidden;
  /* Keeps white card text readable while the lazy image is still loading. */
  background: #140808;
}

.orbit-card-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  transition: transform 0.35s var(--tm-ease-out);
}

.orbit-card:hover .orbit-card-media img,
.orbit-card:focus-within .orbit-card-media img {
  transform: scale(1.06);
}

.orbit-card.is-open .orbit-card-media::after {
  background: linear-gradient(
    to top,
    rgba(10, 4, 4, 0.96) 0%,
    rgba(252, 0, 10, 0.72) 55%,
    rgba(20, 8, 8, 0.55) 100%
  );
}

.orbit-card.is-open .orbit-desc {
  opacity: 1;
  max-height: 118px;
  margin-top: 10px;
  transform: translateY(0);
}

.orbit-card.is-open h3 {
  transform: translateY(-4px);
}

.orbit-card-media::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(8, 4, 4, 0.9) 0%,
    rgba(8, 4, 4, 0.4) 45%,
    rgba(8, 4, 4, 0.08) 100%
  );
  pointer-events: none;
  transition: background 0.25s var(--tm-ease-out);
}

.orbit-card:hover .orbit-card-media::after,
.orbit-card:focus-within .orbit-card-media::after {
  background: linear-gradient(
    to top,
    rgba(10, 4, 4, 0.96) 0%,
    rgba(252, 0, 10, 0.72) 55%,
    rgba(20, 8, 8, 0.55) 100%
  );
}

.orbit-card-body {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  /* A circle's inscribed square is ~70% of its diameter, so a 15% inset on
     every side keeps text off the curve instead of letting it clip. */
  padding: 15%;
  text-align: center;
  pointer-events: none;
}

.orbit-card .card-icon {
  display: none;
}

.orbit-card h3 {
  font-size: clamp(0.82rem, 1.8vw, 1.05rem);
  line-height: 1.28;
  margin: 0;
  color: #fff;
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
  transition: transform 0.22s var(--tm-ease-out);
  max-width: 100%;
  overflow-wrap: break-word;
  hyphens: auto;
}

.orbit-card .orbit-desc {
  margin: 0;
  padding: 0;
  max-width: 100%;
  overflow-wrap: break-word;
  font-size: clamp(0.7rem, 1.4vw, 0.8rem);
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transform: translateY(8px);
  transition:
    opacity 0.22s var(--tm-ease-out),
    max-height 0.28s var(--tm-ease-out),
    transform 0.22s var(--tm-ease-out),
    margin 0.22s var(--tm-ease-out);
}

.orbit-card:hover h3,
.orbit-card:focus-within h3 {
  transform: translateY(-4px);
}

.orbit-card:hover .orbit-desc,
.orbit-card:focus-within .orbit-desc {
  opacity: 1;
  max-height: 118px;
  margin-top: 10px;
  transform: translateY(0);
}

.orbit-card .eyebrow {
  display: none;
}

@media (hover: none) {
  .orbit-card {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
}

@media (max-width: 900px) {
  .orbit-cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 640px;
  }
}

@media (max-width: 540px) {
  .orbit-cards {
    grid-template-columns: 1fr;
    max-width: min(340px, 92vw);
  }

  .orbit-card {
    max-width: min(340px, 92vw);
  }
}

/* Split layout — text left, cards right */
.split-section {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
  gap: clamp(28px, 5vw, 56px);
  align-items: start;
}

.split-section .section-intro {
  margin-bottom: 0;
  max-width: none;
}

.stack-cards {
  display: flex;
  flex-direction: column;
  gap: clamp(16px, 2.5vw, 22px);
}

.partners-grid {
  display: flex;
  flex-direction: column;
  gap: clamp(16px, 2.5vw, 22px);
}

.mission-grid {
  display: none;
}

.mission-card, .partner-card {
  border-radius: var(--tm-radius-lg);
  padding: var(--tm-card-pad);
  min-height: 180px;
}

.partner-card {
  min-height: 280px;
  display: flex;
  flex-direction: column;
}

.partner-card .card-icon {
  width: 60px;
  height: 60px;
  font-size: 1.5rem;
}

.partner-card .btn {
  margin-top: auto;
  align-self: flex-start;
}

.mission-card h3, .partner-card h3 {
  font-size: 1.2rem;
  margin: 8px 0 12px;
  color: var(--tm-heading);
}

.mission-card p, .partner-card p {
  color: var(--tm-muted);
  font-size: 0.92rem;
  margin: 0;
  line-height: 1.65;
}

/* FAQ */
.faq-list {
  display: grid;
  gap: 14px;
  max-width: 860px;
  margin-inline: auto;
}

.faq-item {
  border-radius: var(--tm-radius);
  padding: 0;
}

/* An accordion that lifts on hover reads as unstable, so opt out of .crystal's lift. */
.faq-item.crystal:hover {
  transform: none;
}

.faq-question {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: clamp(18px, 2.6vw, 24px) clamp(20px, 3vw, 28px);
  cursor: pointer;
  list-style: none;
  font-family: var(--tm-font-display);
  font-size: clamp(1rem, 2vw, 1.2rem);
  letter-spacing: 0.02em;
  color: var(--tm-heading);
}

.faq-question::-webkit-details-marker {
  display: none;
}

.faq-question:focus-visible {
  outline: 2px solid var(--tm-accent);
  outline-offset: -4px;
}

.faq-icon {
  position: relative;
  flex: 0 0 auto;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--tm-accent-soft);
  transition: transform 0.24s var(--tm-ease-out), background 0.24s var(--tm-ease-out);
}

.faq-icon::before,
.faq-icon::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10px;
  height: 2px;
  border-radius: 2px;
  background: var(--tm-accent);
  transform: translate(-50%, -50%);
  transition: opacity 0.2s var(--tm-ease-out), background 0.24s var(--tm-ease-out);
}

.faq-icon::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.faq-item[open] .faq-icon {
  transform: rotate(180deg);
  background: var(--tm-accent);
}

.faq-item[open] .faq-icon::before {
  background: #fff;
}

.faq-item[open] .faq-icon::after {
  opacity: 0;
}

.faq-answer {
  padding: 0 clamp(20px, 3vw, 28px) clamp(20px, 3vw, 26px);
  color: var(--tm-muted);
  font-size: 0.95rem;
  line-height: 1.7;
}

.faq-answer p {
  margin: 0 0 10px;
}

.faq-answer p:last-child {
  margin-bottom: 0;
}

.faq-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: var(--tm-space-lg);
  text-align: center;
}

.faq-cta p {
  margin: 0;
  color: var(--tm-muted);
}

/* CTA */
.cta-box {
  border-radius: calc(var(--tm-radius-lg) + 6px);
  padding: clamp(44px, 6vw, 64px) clamp(28px, 4vw, 48px);
  text-align: center;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(252, 0, 10, 0.16);
}

.cta-box .section-title::after {
  margin-inline: auto;
}

.cta-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(20px, 4vw, 32px);
  margin-top: 28px;
  text-align: left;
}

.cta-split-card {
  padding: 24px;
  border-radius: var(--tm-radius);
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(252, 0, 10, 0.1);
}

.cta-split-card h3 {
  font-size: 1.15rem;
  margin: 0 0 8px;
  color: var(--tm-heading);
}

.cta-split-card p {
  color: var(--tm-muted);
  font-size: 0.9rem;
  margin: 0 0 16px;
  line-height: 1.65;
}

.cta-box::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 0%, rgba(252, 0, 10, 0.15), transparent 60%);
  pointer-events: none;
}

.cta-box h2 {
  font-size: clamp(1.8rem, 4vw, 3rem);
  margin-bottom: 12px;
  color: var(--tm-heading);
}

/* Forms */
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.form-grid .full { grid-column: 1 / -1; }

label {
  display: block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 6px;
  color: var(--tm-muted);
}

.field, .toolbar select, .qty input, .password-form input {
  width: 100%;
  padding: 12px 14px;
  border-radius: 12px;
  border: 1px solid var(--tm-border);
  background: rgba(255, 255, 255, 0.95);
  color: var(--tm-heading);
  transition: border-color 0.2s, box-shadow 0.2s;
}

.field:focus, .toolbar select:focus, .qty input:focus {
  outline: none;
  border-color: rgba(252, 0, 10, 0.45);
  box-shadow: 0 0 0 3px rgba(252, 0, 10, 0.12);
}

.steps { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 20px 0; }

.step-pill {
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border: 1px solid var(--tm-border);
  color: var(--tm-muted);
}

.step-pill.is-active {
  border-color: rgba(252, 0, 10, 0.45);
  background: var(--tm-accent-soft);
  color: #fff;
}

.form-error { color: #ef4444; margin-top: 10px; }
.form-success { color: var(--tm-live); margin-top: 10px; }

/* Footer */
.site-footer {
  padding: clamp(48px, 6vw, 64px) 0 24px;
  border-top: 1px solid var(--tm-border);
  background: linear-gradient(180deg, var(--tm-bg-soft) 0%, #fff5f0 100%);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr;
  gap: 32px;
  margin-bottom: 36px;
}

.footer-brand p { color: var(--tm-muted); margin-top: 14px; max-width: 38ch; font-size: 0.92rem; }

.footer-links h4 {
  font-family: var(--tm-font-body);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-bottom: 14px;
  color: var(--tm-heading);
}

.footer-links a, .footer-links p {
  display: block;
  color: var(--tm-muted);
  margin-bottom: 10px;
  font-size: 14px;
}

.footer-links a:hover { color: var(--tm-accent); }

.footer-bottom {
  border-top: 1px solid var(--tm-border);
  padding-top: 18px;
  display: flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--tm-muted);
}

/* Product / collection / cart */
.collection-hero {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 24px;
  align-items: end;
  margin-bottom: 28px;
}

.collection-hero img {
  width: 100%; height: 260px;
  object-fit: cover;
  border-radius: var(--tm-radius);
}

.toolbar {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 20px;
  color: var(--tm-muted);
}

.product-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
  gap: 36px;
  align-items: start;
}

.product-media {
  width: 100%;
}

.product-media-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: clamp(280px, 36vw, 420px);
  padding: clamp(12px, 2vw, 20px);
  background: #fff;
  border-radius: var(--tm-radius-lg);
  border: 1px solid rgba(252, 0, 10, 0.08);
}

.product-media-frame img,
.product-media > img {
  width: 100%;
  max-width: 420px;
  height: auto;
  max-height: min(46vh, 400px);
  object-fit: contain;
  border-radius: 0;
}

.thumbs { display: flex; gap: 8px; margin-top: 14px; overflow: auto; }

.thumbs img {
  width: 88px; height: 88px;
  object-fit: cover;
  border-radius: 10px;
  border: 1px solid var(--tm-border);
  cursor: pointer;
}

.option-row { margin: 16px 0; }
.option-row legend {
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 8px;
  color: var(--tm-muted);
}

.swatches { display: flex; flex-wrap: wrap; gap: 8px; }

.swatches label {
  padding: 8px 14px;
  border-radius: 999px;
  border: 1px solid var(--tm-border);
  cursor: pointer;
  font-size: 13px;
  transition: all 0.2s;
}

.swatches label { position: relative; }
.swatches input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  opacity: 0;
  cursor: pointer;
}

.product-selected-variant {
  margin: 8px 0 0;
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--tm-heading);
}

.swatches label:has(input:checked) {
  border-color: var(--tm-accent);
  background: var(--tm-accent-soft);
  color: #fff;
}

.qty { display: flex; align-items: center; gap: 8px; margin: 16px 0 20px; }

.qty button {
  width: 40px; height: 40px;
  border-radius: 10px;
  border: 1px solid var(--tm-border);
  background: var(--tm-glass);
}

.product-meta { color: var(--tm-muted); margin-top: 20px; line-height: 1.7; }

.product-details {
  padding: clamp(32px, 5vw, 56px) 0 40px;
  background: #fff8f6;
  color: #2a1c1c;
  overflow: hidden;
}

.product-details-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 32px;
  align-items: start;
  max-width: 100%;
}

.product-details-copy,
.product-details-list,
.product-details-care {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.product-details-heading {
  font-family: var(--tm-font-display);
  font-size: clamp(1.4rem, 2.4vw, 2rem);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin: 0 0 28px;
  color: #111;
}

.product-details-list {
  margin: 0;
  padding-left: 1.25em;
  color: #5a4a4a;
  font-size: 1rem;
  line-height: 1.85;
}

.product-details-list li + li { margin-top: 6px; }

.product-details-label {
  font-weight: 700;
  color: #2a1c1c;
}

.product-details-care {
  margin: 28px 0 0;
  color: #5a4a4a;
  font-size: 1rem;
  line-height: 1.7;
}

.product-size-card {
  grid-column: 1 / -1;
  margin-top: 8px;
  max-width: 100%;
}

.product-size-mobile { display: none; }

.product-size-table-wrap {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.product-size-table {
  width: 100%;
  min-width: 640px;
  border-collapse: collapse;
  color: #5a4a4a;
  font-size: 0.92rem;
  background: #fff;
}

.product-size-table th,
.product-size-table td {
  border: 1px solid #ece6e4;
  padding: 10px 8px;
  text-align: center;
  font-weight: 400;
}

.product-size-table thead th {
  color: #2a1c1c;
  font-weight: 600;
  background: #fff;
}

.product-size-table tbody th {
  text-align: left;
  padding-left: 14px;
  color: #2a1c1c;
  font-weight: 600;
  white-space: nowrap;
}

.product-size-shipping {
  margin: 22px 0 0;
  color: #2a1c1c;
  font-size: 1rem;
}

.cart-layout { display: grid; grid-template-columns: 1.4fr 0.8fr; gap: 32px; align-items: start; }

.cart-item {
  display: grid;
  grid-template-columns: 180px 1fr auto;
  gap: 20px;
  padding: 20px 0;
  border-bottom: 1px solid var(--tm-border);
  align-items: center;
}

.cart-item-media {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180px;
  height: 180px;
  background: #fff;
  border-radius: 16px;
  border: 1px solid rgba(252, 0, 10, 0.08);
  overflow: hidden;
}

.cart-item img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 12px;
  border-radius: 0;
}

.cart-item-copy strong {
  display: block;
  font-size: 1.05rem;
  margin-bottom: 4px;
}

.cart-item-variant,
.cart-item-copy .price {
  margin: 0 0 8px;
  color: var(--tm-muted);
}

.cart-item-remove {
  display: inline-block;
  margin-top: 8px;
  font-size: 13px;
  color: var(--tm-muted);
}

.cart-item-price { font-size: 1.1rem; }

.cart-summary {
  border-radius: var(--tm-radius-lg);
  padding: 24px;
  height: fit-content;
  border: 1px solid var(--tm-border);
}

.cart-summary h2 {
  font-size: 1.2rem;
  margin: 0 0 16px;
}

.cart-summary-row {
  display: flex;
  justify-content: space-between;
  margin: 0 0 12px;
}

.cart-summary-copy {
  color: var(--tm-muted);
  margin: 0 0 10px;
  line-height: 1.5;
}

.cart-summary .btn-full { margin-top: 12px; }

/* Drawer / modal */
.cart-drawer {
  position: fixed; inset: 0; z-index: 80;
  pointer-events: none;
}

.cart-drawer.is-open { pointer-events: auto; }
body.cart-open { overflow: hidden; }

.cart-drawer-overlay {
  position: absolute; inset: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  opacity: 0;
  transition: opacity 0.3s;
}

.cart-drawer.is-open .cart-drawer-overlay { opacity: 1; }

.cart-drawer-panel {
  position: absolute; right: 0; top: 0;
  height: 100%;
  width: min(400px, 100%);
  background: #fff;
  color: #111;
  border-left: 1px solid #ece6e4;
  transform: translate3d(100%, 0, 0);
  transition: transform 0.35s var(--tm-ease);
  display: flex;
  flex-direction: column;
}

.cart-drawer .drawer-head h2,
.cart-drawer .drawer-foot,
.cart-drawer .cart-item,
.cart-drawer .cart-item strong {
  color: #111;
}

.cart-drawer .drawer-head,
.cart-drawer .drawer-foot {
  border-color: #ece6e4;
}

.cart-drawer .price,
.cart-drawer .empty-state,
.cart-drawer .cart-item .price {
  color: #5a4a4a;
}

.cart-drawer .qty button {
  background: #fff;
  color: #111;
  border-color: #ddd;
}

.cart-drawer .cart-item {
  grid-template-columns: 88px 1fr auto;
  gap: 12px;
  padding: 14px 0;
}

.cart-drawer .cart-item-media {
  width: 88px;
  height: 88px;
}

.cart-drawer.is-open .cart-drawer-panel { transform: none; }

.drawer-head, .drawer-foot {
  padding: 16px 20px;
  border-bottom: 1px solid var(--tm-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.drawer-foot {
  border-bottom: 0;
  border-top: 1px solid var(--tm-border);
  margin-top: auto;
  display: block;
}

.drawer-body { overflow: auto; padding: 12px 20px; flex: 1; }

.search-modal {
  position: fixed; inset: 0; z-index: 90;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8px);
  display: none;
  padding: 12vh 20px 20px;
}

.search-modal.is-open { display: block; }

.search-modal form { width: min(640px, 100%); margin: 0 auto; }

.search-modal input {
  width: 100%;
  padding: 18px 20px;
  border-radius: var(--tm-radius);
  border: 1px solid #e6dedb;
  background: #fff;
  color: #111;
  font-size: 17px;
}

.search-modal input::placeholder { color: #7a564c; }

.search-modal-copy {
  text-align: center;
  margin-top: 14px;
  color: #fff;
}

.athlete-search-results {
  margin-top: 16px;
  max-height: min(56vh, 480px);
  overflow: auto;
  display: grid;
  gap: 8px;
}

.athlete-search-hit {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 14px;
  background: #fff;
  color: #111;
  text-decoration: none;
  min-height: 64px;
}

.athlete-search-hit img {
  width: 48px;
  height: 48px;
  object-fit: cover;
  border-radius: 10px;
  background: #f4f1ef;
  flex: 0 0 48px;
}

.athlete-search-hit span {
  font-weight: 700;
  font-size: 0.98rem;
}

.athlete-search-empty {
  background: #fff;
  color: #5a4a4a;
  border-radius: 14px;
  padding: 16px;
  text-align: center;
}

.empty-state { text-align: center; padding: 48px 20px; color: var(--tm-muted); }

.pagination {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 32px;
}

.pagination a, .pagination span {
  min-width: 40px; height: 40px;
  display: grid; place-items: center;
  border-radius: 10px;
  border: 1px solid var(--tm-border);
}

.rte { color: var(--tm-muted); max-width: 72ch; line-height: 1.75; }
.rte h1, .rte h2, .rte h3 { color: var(--tm-heading); margin: 1.2em 0 0.4em; }
.rte a { color: var(--tm-accent); text-decoration: underline; }

.account-card {
  border-radius: var(--tm-radius-lg);
  padding: 28px;
  max-width: 440px;
  margin: 0 auto;
}

.password-page, .password-wrap {
  min-height: 100vh;
  display: grid;
  place-items: center;
  text-align: center;
  padding: 40px 20px;
}

.gift-card {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 40px;
}

/* Responsive */
@media (max-width: 980px) {
  :root {
    --tm-section-py: clamp(2.5rem, 5vw, 4rem);
    --tm-section-min: auto;
    --tm-header: 64px;
  }

  .header-nav { display: none; }
  .menu-toggle { display: grid; }
  .desktop-only { display: none !important; }
  .mobile-only.header-signup { display: none !important; }

  #shopify-section-group-header-group,
  .shopify-section-group-header-group,
  #shopify-section-header,
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    overflow: visible;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transform: none;
  }

  html { scroll-behavior: auto; }

  .announcement-track {
    animation: none;
    justify-content: center;
    min-width: 0;
    width: 100%;
  }

  .announcement-track span:nth-child(n + 2) { display: none; }

  .reveal,
  .reveal-stagger > * {
    opacity: 1 !important;
    transform: none !important;
    animation: none !important;
    transition: none !important;
  }

  body {
    background-attachment: scroll;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-nav,
  .mobile-drawer {
    display: none;
    position: fixed;
    top: calc(var(--tm-announce, 32px) + var(--tm-header, 64px));
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    padding: 8px 20px 32px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    background: #fff;
    border-top: 1px solid var(--tm-border);
  }

  .mobile-nav.is-open,
  .mobile-drawer.is-open { display: block; }

  body.menu-open,
  body.search-open { overflow: hidden; }

  .mobile-nav a,
  .mobile-drawer a {
    display: block;
    padding: 16px 0;
    border-bottom: 1px solid var(--tm-border);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: auto;
  }

  .stores-cta-panel { grid-template-columns: 1fr; }
  .stores-cta-visual { order: -1; max-width: 480px; margin-inline: auto; width: 100%; }

  .hero-grid,
  .stats-grid, .stages,
  .mission-grid, .review-grid, .about-grid,
  .partners-grid, .footer-grid,
  .product-layout, .cart-layout,
  .collection-hero, .contact-layout,
  .form-grid {
    grid-template-columns: 1fr;
  }

  .product-media-frame {
    min-height: clamp(220px, 52vw, 320px);
    padding: 12px;
  }

  .main-product,
  .main-cart,
  .product-layout,
  .product-details {
    overflow: visible;
    -webkit-overflow-scrolling: touch;
    content-visibility: visible;
  }

  .product-layout > div {
    min-width: 0;
  }

  .option-row {
    margin: 18px 0;
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    overflow: visible;
  }

  .swatches label {
    min-height: 44px;
    padding: 10px 16px;
    display: inline-flex;
    align-items: center;
  }

  .swatches label,
  .qty button,
  .thumbs img {
    touch-action: manipulation;
  }

  .thumbs {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
  }

  .product-details-grid {
    grid-template-columns: 1fr;
  }

  .product-size-table-wrap { display: none; }

  .product-size-mobile {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .product-size-mobile-card {
    background: #fff;
    border: 1px solid #ece6e4;
    border-radius: 14px;
    padding: 14px 16px;
  }

  .product-size-mobile-card h3 {
    margin: 0 0 10px;
    font-size: 1.1rem;
    color: #111;
  }

  .product-size-mobile-card p {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 6px;
    font-size: 0.95rem;
    color: #5a4a4a;
  }

  .product-size-mobile-card span {
    font-weight: 700;
    color: #2a1c1c;
  }

  .athlete-grid, .product-grid, .category-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero {
    min-height: auto;
    padding-top: clamp(2rem, 5vw, 3rem);
  }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .hero-media {
    order: -1;
    max-width: min(340px, 100%);
    margin-inline: auto;
    margin-left: auto;
  }

  .hero-image-frame { max-height: none; aspect-ratio: auto; }
  .hero-image-frame img, .hero-art-img, .hero-art-video, .hero-art-embed { max-width: min(320px, 100%); }

  .store-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .store-search { min-width: 0; width: 100%; }
  .store-count { margin-left: 0; width: 100%; text-align: center; }

  .filter-chip { flex: 1; text-align: center; min-width: calc(33% - 8px); }

  .roster, .engine, .mission, .testimonials {
    min-height: auto;
    display: block;
  }

  .section-title { animation: none; }
}

@media (max-width: 640px) {
  :root { --tm-announce: 32px; --tm-gutter: clamp(1.25rem, 5vw, 1.75rem); }

  .athlete-grid, .product-grid, .category-grid, .review-grid, .stats-grid, .stages {
    grid-template-columns: 1fr;
  }

  .about-block .about-grid,
  .about-layout {
    grid-template-columns: 1fr;
  }

  .split-section {
    grid-template-columns: 1fr;
  }

  .cta-split { grid-template-columns: 1fr; }
  .cart-drawer-panel { width: 100%; }
  .cart-drawer .cart-item { grid-template-columns: 72px 1fr auto; }
  .cart-drawer .cart-item-media { width: 72px; height: 72px; }
  .search-modal { padding: 10vh 16px 16px; }
  .athlete-search-results { max-height: 52vh; }
  .footer-bottom { flex-direction: column; text-align: center; }
  .section-head { flex-direction: column; align-items: flex-start; }
  .hero h1 { font-size: clamp(2rem, 9vw, 2.8rem); }
  .hero-actions { flex-direction: column; }
  .hero-actions .btn { width: 100%; }
  .hero-media { max-width: min(300px, 100%); }
  .hero-image-frame { max-height: none; aspect-ratio: auto; }
  .hero-image-frame img, .hero-art-img, .hero-art-video, .hero-art-embed { max-width: min(280px, 100%); }
  .btn { min-height: 48px; font-size: 11px; }
  .icon-btn { width: 44px; height: 44px; }
  .stat-card, .stage { min-height: auto; }
  .logo-text { letter-spacing: 0.1em; }
  .announcement-track { font-size: 9px; gap: 28px; }
  .stores-cta-panel { padding: 24px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  .reveal,
  .reveal-stagger > * { opacity: 1; transform: none; }
  .reviews-track { animation: none; flex-wrap: wrap; width: 100%; justify-content: center; }
  .reviews-marquee { mask-image: none; -webkit-mask-image: none; }
}
