<section class="main-page">
  <div class="page-width">
    <p class="eyebrow">{{ blog.title }}</p>
    <h1 class="section-title">{{ blog.title }}</h1>
    <div class="partners-grid">
      {%- for article in blog.articles -%}
        <a class="info-card" href="{{ article.url }}">
          {%- if article.image -%}
            <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" style="border-radius:12px;margin-bottom:14px;height:180px;width:100%;object-fit:cover;">
          {%- endif -%}
          <h3>{{ article.title }}</h3>
          <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
