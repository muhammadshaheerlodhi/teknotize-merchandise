<section class="product-details">
  <div class="page-width product-details-grid">
    <div class="product-details-gallery">
      {%- if product.images.size > 0 -%}
        {%- for image in product.images -%}
          <button type="button" class="product-details-swatch" data-product-thumb="{{ image | image_url: width: 1800 }}">
            <img
              src="{{ image | image_url: width: 400 }}"
              alt="{{ image.alt | default: product.title | escape }}"
              width="400"
              height="400"
              loading="lazy"
            >
          </button>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="product-details-copy">
      <h2 class="product-details-heading">{{ section.settings.heading }}</h2>
      {%- if section.blocks.size > 0 -%}
        <ol class="product-details-list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="product-details-label">{{ block.settings.label }}:</span>
              {{ block.settings.value }}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
      {%- if section.settings.care != blank -%}
        <p class="product-details-care">
          <span class="product-details-label">Care:</span>
          {{ section.settings.care }}
        </p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_size_chart -%}
      <div class="product-size-card">
        <div class="product-size-table-wrap">
          <table class="product-size-table">
            <thead>
              <tr>
                <th></th>
                <th colspan="2">S</th>
                <th colspan="2">M</th>
                <th colspan="2">L</th>
                <th colspan="2">XL</th>
                <th colspan="2">2XL</th>
              </tr>
              <tr>
                <th></th>
                <th>inch</th><th>cm</th>
                <th>inch</th><th>cm</th>
                <th>inch</th><th>cm</th>
                <th>inch</th><th>cm</th>
                <th>inch</th><th>cm</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th>Length</th>
                <td>26.77</td><td>68</td>
                <td>27.56</td><td>70</td>
                <td>28.35</td><td>72</td>
                <td>29.13</td><td>74</td>
                <td>29.92</td><td>76</td>
              </tr>
              <tr>
                <th>Chest</th>
                <td>23.62</td><td>60</td>
                <td>24.41</td><td>62</td>
                <td>25.20</td><td>64</td>
                <td>25.98</td><td>66</td>
                <td>26.77</td><td>68</td>
              </tr>
              <tr>
                <th>Shoulder</th>
                <td>24.02</td><td>61</td>
                <td>24.80</td><td>63</td>
                <td>25.59</td><td>65</td>
                <td>26.38</td><td>67</td>
                <td>27.17</td><td>69</td>
              </tr>
              <tr>
                <th>Sleeve length</th>
                <td>20.08</td><td>51</td>
                <td>20.47</td><td>52</td>
                <td>20.87</td><td>53</td>
                <td>21.26</td><td>54</td>
                <td>21.65</td><td>55</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="product-size-shipping">Free shipping on orders $150+.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product details",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Details"
    },
    {
      "type": "textarea",
      "id": "care",
      "label": "Care",
      "default": "Machine wash at 30°C. Do not bleach. Tumble dry low. Iron on low, avoiding the print. Do not dry clean."
    },
    {
      "type": "checkbox",
      "id": "show_size_chart",
      "label": "Show size chart",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Gender" },
        { "type": "text", "id": "value", "label": "Value", "default": "Unisex" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product details",
      "blocks": [
        { "type": "spec", "settings": { "label": "Gender", "value": "Unisex" } },
        { "type": "spec", "settings": { "label": "Fabric", "value": "42% Cotton, 53% Polyester, 5% Other Fibers" } },
        { "type": "spec", "settings": { "label": "Weight", "value": "10.3 oz/yd² (350g/m²)" } },
        { "type": "spec", "settings": { "label": "Thickness", "value": "Thick" } },
        { "type": "spec", "settings": { "label": "Stretch", "value": "Slight Stretch" } },
        { "type": "spec", "settings": { "label": "Fit", "value": "Regular / Loose" } },
        { "type": "spec", "settings": { "label": "Style", "value": "Long Sleeve, Drop Shoulder, Hooded" } },
        { "type": "spec", "settings": { "label": "Season", "value": "Autumn / Winter" } }
      ]
    }
  ]
}
{% endschema %}
