<section class="main-search">
  <div class="page-width">
    <p class="eyebrow">THE ATHLETES</p>
    <h1 class="section-title">Search athletes</h1>
    <p class="lede">Find an athlete storefront by name. Clear the box to see every store again.</p>

    <form data-athlete-filter-form style="max-width:640px;margin:28px 0;">
      <input class="field" id="athlete-search" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search athletes" autocomplete="off">
    </form>

    <div class="athlete-grid" data-athlete-grid>
      {%- assign athlete_stores = collections | sort: 'published_at' | reverse -%}
      {%- for collection in athlete_stores -%}
        {%- if collection.handle == 'all' or collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        {% render 'collection-card', collection: collection %}
      {%- endfor -%}
    </div>
    <p class="no-results" data-no-results>No athletes found.</p>
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
