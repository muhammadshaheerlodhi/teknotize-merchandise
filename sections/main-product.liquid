<section class="main-product">
  <div class="page-width">
    {%- liquid
      assign current_variant = product.selected_or_first_available_variant
      assign athlete_store = false
      if product
        for collection in product.collections
          if collection.handle == 'all' or collection.handle == 'frontpage'
            continue
          endif
          assign collection_name = collection.title | downcase
          assign product_name = product.title | downcase
          if product_name contains collection_name
            assign athlete_store = collection
            break
          endif
        endfor
      endif
      unless athlete_store
        if product
          for collection in product.collections
            if collection.handle == 'all' or collection.handle == 'frontpage'
              continue
            endif
            assign athlete_store = collection
            break
          endfor
        endif
      endunless
      assign athlete_store_url = athlete_store.url | default: routes.collections_url
      assign athlete_store_title = athlete_store.title | default: 'Athlete Store'
    -%}
    <div class="product-layout">
      <div class="product-media">
        {%- liquid
          assign main_image = current_variant.featured_image | default: product.featured_image
        -%}
        {%- if main_image -%}
          <div class="product-media-frame">
            <img
              data-product-main
              src="{{ main_image | image_url: width: 1800 }}"
              alt="{{ main_image.alt | default: product.title | escape }}"
              width="1800"
              height="1800"
            >
          </div>
        {%- endif -%}
        {%- if product.images.size > 1 -%}
          <div class="thumbs">
            {%- for image in product.images -%}
              <img
                src="{{ image | image_url: width: 240 }}"
                alt="{{ image.alt | escape }}"
                data-product-thumb="{{ image | image_url: width: 1800 }}"
                {% if image.variants.first %}data-thumb-option1="{{ image.variants.first.option1 | escape }}"{% endif %}
              >
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product-buy">
        {%- if athlete_store -%}
          <a class="product-athlete-link" href="{{ athlete_store_url }}">{{ athlete_store_title }}</a>
        {%- endif -%}
        <p class="eyebrow">{{ product.vendor | default: 'Teknotize Merchandise' }}</p>
        <h1 class="section-title product-title">{{ product.title }}</h1>
        <p class="price" data-product-price style="font-size:1.25rem;margin:12px 0 20px;">
          {{ current_variant.price | money }}
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="compare">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
        </p>

        {% form 'product', product, data-product-form: '' %}
          <span hidden data-athlete-store="{{ athlete_store_url }}"></span>
          <script type="application/json" data-product-json>
            {
              "id": {{ product.id | json }},
              "variants": [
                {%- for variant in product.variants -%}
                  {%- liquid
                    assign v_image = ''
                    if variant.featured_image != blank
                      assign v_image = variant.featured_image | image_url: width: 1800
                    elsif variant.image != blank
                      assign v_image = variant.image | image_url: width: 1800
                    endif
                    if v_image == blank
                      for image in product.images
                        if image.variants != blank
                          for attached in image.variants
                            if attached.id == variant.id
                              assign v_image = image | image_url: width: 1800
                              break
                            endif
                          endfor
                        endif
                        if v_image != blank
                          break
                        endif
                      endfor
                    endif
                  -%}
                  {
                    "id": {{ variant.id | json }},
                    "available": {{ variant.available | json }},
                    "price": {{ variant.price | money | json }},
                    "title": {{ variant.title | json }},
                    "option1": {{ variant.option1 | json }},
                    "option2": {{ variant.option2 | json }},
                    "option3": {{ variant.option3 | json }},
                    "featured_image": {{ v_image | json }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }
          </script>
          <select name="id" data-variant-select class="visually-hidden" tabindex="-1" aria-hidden="true">
            {%- for variant in product.variants -%}
              {%- liquid
                assign v_image = ''
                if variant.featured_image != blank
                  assign v_image = variant.featured_image | image_url: width: 1800
                elsif variant.image != blank
                  assign v_image = variant.image | image_url: width: 1800
                endif
                if v_image == blank
                  for image in product.images
                    if image.variants != blank
                      for attached in image.variants
                        if attached.id == variant.id
                          assign v_image = image | image_url: width: 1800
                          break
                        endif
                      endfor
                    endif
                    if v_image != blank
                      break
                    endif
                  endfor
                endif
              -%}
              <option
                value="{{ variant.id }}"
                {% if variant == current_variant %}selected{% endif %}
                data-available="{{ variant.available }}"
                data-price="{{ variant.price | money }}"
                data-option1="{{ variant.option1 | escape }}"
                data-option2="{{ variant.option2 | escape }}"
                data-option3="{{ variant.option3 | escape }}"
                {% if v_image != blank %}data-image="{{ v_image }}"{% endif %}
              >
                {{ variant.title }} — {{ variant.price | money }}
              </option>
            {%- endfor -%}
          </select>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_key = option.name | downcase -%}
              <fieldset class="option-row{% if option_key contains 'size' %} option-row--size{% endif %}">
                <legend>
                  {{ option.name }}
                  {%- if option_key contains 'size' -%}
                    <a class="size-chart-btn" href="#size-chart">Size chart</a>
                  {%- endif -%}
                </legend>
                <div class="swatches">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign swatch_image = ''
                      assign option_selected = false
                      if option.position == 1 and current_variant.option1 == value
                        assign option_selected = true
                      elsif option.position == 2 and current_variant.option2 == value
                        assign option_selected = true
                      elsif option.position == 3 and current_variant.option3 == value
                        assign option_selected = true
                      endif
                      for variant in product.variants
                        assign match = false
                        if option.position == 1 and variant.option1 == value
                          assign match = true
                        elsif option.position == 2 and variant.option2 == value
                          assign match = true
                        elsif option.position == 3 and variant.option3 == value
                          assign match = true
                        endif
                        if match and variant.featured_image != blank
                          assign swatch_image = variant.featured_image | image_url: width: 1800
                          break
                        endif
                      endfor
                    -%}
                    <label>
                      <input
                        type="radio"
                        name="option-{{ option.position }}"
                        value="{{ value | escape }}"
                        data-swatch
                        data-option-position="{{ option.position }}"
                        data-image="{{ swatch_image }}"
                        {% if option_selected %}checked{% endif %}
                      >
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
                {%- if option_key contains 'size' -%}
                  <p class="size-chart-hint">Not sure of your size? Check the size chart below.</p>
                {%- endif -%}
              </fieldset>
            {%- endfor -%}
            <p class="product-selected-variant" data-selected-variant>{{ current_variant.title }}</p>
          {%- endunless -%}

          <div class="qty">
            <label for="Quantity">Qty</label>
            <button type="button" onclick="const i=this.parentNode.querySelector('input'); i.value=Math.max(1, Number(i.value)-1)">−</button>
            <input id="Quantity" type="number" name="quantity" value="1" min="1">
            <button type="button" onclick="const i=this.parentNode.querySelector('input'); i.value=Number(i.value)+1">+</button>
          </div>

          <button
            type="submit"
            class="btn btn-primary btn-full"
            data-add-btn
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
          </button>
        {% endform %}

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
