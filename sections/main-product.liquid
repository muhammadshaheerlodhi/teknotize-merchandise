<section class="main-product">
  <div class="page-width">
    {%- liquid
      assign current_variant = product.selected_or_first_available_variant
      assign athlete_store = false
      assign color_position = 0

      for option in product.options_with_values
        assign option_key = option.name | downcase
        if option_key contains 'color' or option_key contains 'colour'
          assign color_position = option.position
        endif
      endfor
      if color_position == 0
        assign color_position = 1
      endif

      if product
        for collection in product.collections
          if collection.handle == 'all' or collection.handle == 'frontpage'
            continue
          endif
          assign collection_name = collection.title | downcase
          assign product_name = product.title | downcase
          if product_name contains collection_name
            assign athlete_store = collection
            break
          endif
        endfor
      endif
      unless athlete_store
        if product
          for collection in product.collections
            if collection.handle == 'all' or collection.handle == 'frontpage'
              continue
            endif
            assign athlete_store = collection
            break
          endfor
        endif
      endunless
      assign athlete_store_url = athlete_store.url | default: routes.collections_url
    -%}
    <div class="product-layout">
      <div class="product-media">
        {%- liquid
          capture main_image_url
            render 'variant-image-url', variant: current_variant, product: product, width: 1800
          endcapture
          assign main_image_url = main_image_url | strip
          if main_image_url == blank and product.featured_image
            assign main_image_url = product.featured_image | image_url: width: 1800
          endif
        -%}
        {%- if main_image_url != blank -%}
          <div class="product-media-frame">
            <img
              data-product-main
              src="{{ main_image_url }}"
              srcset="{{ main_image_url | replace: 'width=1800', 'width=800' }} 800w, {{ main_image_url | replace: 'width=1800', 'width=1200' }} 1200w, {{ main_image_url }} 1800w"
              sizes="(max-width: 980px) 92vw, 46vw"
              alt="{{ current_variant.title | default: product.title | escape }}"
              width="1800"
              height="1800"
              fetchpriority="high"
              decoding="async"
            >
          </div>
        {%- endif -%}
        {%- if product.images.size > 1 -%}
          <div class="thumbs">
            {%- for image in product.images -%}
              {%- liquid
                assign thumb_colors = ''
                if image.variants != blank
                  for attached in image.variants
                    if color_position == 1
                      assign thumb_color = attached.option1
                    elsif color_position == 2
                      assign thumb_color = attached.option2
                    else
                      assign thumb_color = attached.option3
                    endif
                    if thumb_color != blank
                      unless thumb_colors contains thumb_color
                        if thumb_colors != blank
                          assign thumb_colors = thumb_colors | append: '|'
                        endif
                        assign thumb_colors = thumb_colors | append: thumb_color
                      endunless
                    endif
                  endfor
                endif
              -%}
              <img
                src="{{ image | image_url: width: 240 }}"
                alt="{{ image.alt | escape }}"
                data-product-thumb="{{ image | image_url: width: 1800 }}"
                {% if thumb_colors != blank %}data-thumb-colors="{{ thumb_colors | escape }}"{% endif %}
                width="240"
                height="240"
                loading="lazy"
                decoding="async"
              >
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product-buy">
        <h1 class="section-title product-title">{{ product.title }}</h1>
        <p class="price" data-product-price style="font-size:1.25rem;margin:12px 0 20px;">
          {{ current_variant.price | money }}
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="compare">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
        </p>

        {% form 'product', product, data-product-form: '', data-color-position: color_position %}
          <span hidden data-athlete-store="{{ athlete_store_url }}"></span>
          <script type="application/json" data-product-json>
            {
              "id": {{ product.id | json }},
              "color_position": {{ color_position | json }},
              "variants": [
                {%- for variant in product.variants -%}
                  {%- capture v_image -%}
                    {%- render 'variant-image-url', variant: variant, product: product, width: 1800 -%}
                  {%- endcapture -%}
                  {%- assign v_image = v_image | strip -%}
                  {
                    "id": {{ variant.id | json }},
                    "available": {{ variant.available | json }},
                    "price": {{ variant.price | money | json }},
                    "title": {{ variant.title | json }},
                    "option1": {{ variant.option1 | json }},
                    "option2": {{ variant.option2 | json }},
                    "option3": {{ variant.option3 | json }},
                    "featured_image": {{ v_image | json }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }
          </script>
          <select name="id" data-variant-select class="visually-hidden" tabindex="-1" aria-hidden="true">
            {%- for variant in product.variants -%}
              {%- capture v_image -%}
                {%- render 'variant-image-url', variant: variant, product: product, width: 1800 -%}
              {%- endcapture -%}
              {%- assign v_image = v_image | strip -%}
              <option
                value="{{ variant.id }}"
                {% if variant == current_variant %}selected{% endif %}
                data-available="{{ variant.available }}"
                data-price="{{ variant.price | money }}"
                data-option1="{{ variant.option1 | escape }}"
                data-option2="{{ variant.option2 | escape }}"
                data-option3="{{ variant.option3 | escape }}"
                {% if v_image != blank %}data-image="{{ v_image }}"{% endif %}
              >
                {{ variant.title }} — {{ variant.price | money }}
              </option>
            {%- endfor -%}
          </select>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_key = option.name | downcase -%}
              {%- assign is_color_option = false -%}
              {%- if option_key contains 'color' or option_key contains 'colour' -%}
                {%- assign is_color_option = true -%}
              {%- endif -%}
              <fieldset class="option-row{% if option_key contains 'size' %} option-row--size{% endif %}{% if is_color_option %} option-row--color{% endif %}">
                <legend>
                  {{ option.name }}
                  {%- if option_key contains 'size' -%}
                    <a class="size-chart-btn" href="#size-chart">Size chart</a>
                  {%- endif -%}
                </legend>
                <div class="swatches">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign swatch_image = ''
                      assign option_selected = false
                      if option.position == 1 and current_variant.option1 == value
                        assign option_selected = true
                      elsif option.position == 2 and current_variant.option2 == value
                        assign option_selected = true
                      elsif option.position == 3 and current_variant.option3 == value
                        assign option_selected = true
                      endif
                      for variant in product.variants
                        assign match = false
                        if option.position == 1 and variant.option1 == value
                          assign match = true
                        elsif option.position == 2 and variant.option2 == value
                          assign match = true
                        elsif option.position == 3 and variant.option3 == value
                          assign match = true
                        endif
                        if match
                          capture swatch_image
                            render 'variant-image-url', variant: variant, product: product, width: 1800
                          endcapture
                          assign swatch_image = swatch_image | strip
                          if swatch_image != blank
                            break
                          endif
                        endif
                      endfor
                    -%}
                    <label>
                      <input
                        type="radio"
                        name="option-{{ option.position }}"
                        value="{{ value | escape }}"
                        data-swatch
                        data-option-position="{{ option.position }}"
                        {% if is_color_option %}data-color-swatch{% endif %}
                        {% if swatch_image != blank %}data-image="{{ swatch_image }}"{% endif %}
                        {% if option_selected %}checked{% endif %}
                      >
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
                {%- if option_key contains 'size' -%}
                  <p class="size-chart-hint">Not sure of your size? Check the size chart below.</p>
                {%- endif -%}
              </fieldset>
            {%- endfor -%}
            <p class="product-selected-variant" data-selected-variant>{{ current_variant.title }}</p>
          {%- endunless -%}

          <div class="qty">
            <label for="Quantity">Qty</label>
            <button type="button" onclick="const i=this.parentNode.querySelector('input'); i.value=Math.max(1, Number(i.value)-1)">−</button>
            <input id="Quantity" type="number" name="quantity" value="1" min="1">
            <button type="button" onclick="const i=this.parentNode.querySelector('input'); i.value=Number(i.value)+1">+</button>
          </div>

          <button
            type="submit"
            class="btn btn-primary btn-full"
            data-add-btn
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
          </button>
        {% endform %}

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
