<section class="featured-products">
  <div class="page-width">
    <div class="section-head">
      <div>
        <p class="section-label">{{ section.settings.label }}</p>
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      </div>
      <a class="btn btn-ghost" href="{{ routes.all_products_collection_url }}">Shop all</a>
    </div>
    <div class="product-grid">
      {%- assign featured_collection = collections.all -%}
      {%- if section.settings.collection != blank -%}
        {%- assign featured_collection = collections[section.settings.collection] -%}
      {%- endif -%}
      {%- for product in featured_collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Official Storefront" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "LATEST DROPS" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 4, "max": 16, "step": 1, "label": "Products", "default": 8 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
