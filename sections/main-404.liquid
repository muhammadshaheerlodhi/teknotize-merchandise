{%- liquid
  assign show_404 = true
  if request.path == '/' or request.path == blank
    assign show_404 = false
  endif
-%}
{%- if show_404 -%}
<section class="main-404">
  <div class="page-width empty-state">
    <p class="eyebrow">404</p>
    <h1 class="section-title">Page not found</h1>
    <p class="lede" style="margin-inline:auto;">This play did not land. Head back to the store or browse athlete storefronts.</p>
    <div class="hero-actions" style="justify-content:center;">
      <a class="btn btn-primary" href="{{ routes.root_url }}">Home</a>
      <a class="btn btn-ghost" href="{{ routes.collections_url }}">Athlete Stores</a>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}
