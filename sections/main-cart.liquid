<section class="main-cart">
  <div class="page-width">
    <p class="eyebrow">CHECKOUT READY</p>
    <h1 class="section-title">Your cart</h1>

    {%- if cart.item_count == 0 -%}
      <div class="empty-state">
        <p>Your cart is empty.</p>
        <a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
        <p>Have an account? <a href="{{ routes.account_login_url }}">Log in</a> to check out faster.</p>
      </div>
    {%- else -%}
      <div class="cart-layout">
        <div class="cart-lines">
          {%- for item in cart.items -%}
            <article class="cart-item">
              <a class="cart-item-media" href="{{ item.url }}">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 720 }}"
                    alt="{{ item.image.alt | default: item.product.title | escape }}"
                    width="360"
                    height="360"
                  >
                {%- endif -%}
              </a>
              <div class="cart-item-copy">
                <a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="price">{{ item.original_price | money }} each</p>
                <form action="{{ routes.cart_change_url }}" method="post">
                  <input type="hidden" name="id" value="{{ item.key }}">
                  <div class="qty">
                    <label class="visually-hidden" for="CartQty-{{ item.index }}">Quantity</label>
                    <input id="CartQty-{{ item.index }}" type="number" name="quantity" value="{{ item.quantity }}" min="0">
                    <button class="btn btn-ghost" type="submit">Update</button>
                  </div>
                </form>
                <a class="cart-item-remove" href="{{ item.url_to_remove }}">Remove</a>
              </div>
              <strong class="cart-item-price">{{ item.final_line_price | money }}</strong>
            </article>
          {%- endfor -%}
        </div>
        <aside class="cart-summary">
          <h2>Order summary</h2>
          <p class="cart-summary-row"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></p>
          <p class="cart-summary-copy">Shipping and taxes are calculated at checkout.</p>
          <p class="cart-summary-copy">Free shipping on orders $150+.</p>
          <a class="btn btn-primary btn-full" href="/checkout">Checkout</a>
          <a class="btn btn-ghost btn-full" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
        </aside>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
