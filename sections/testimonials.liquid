{%- liquid
  assign proof_images = 'testimonial-fan-jaden.jpg,testimonial-fan-carlos.jpg,testimonial-fan-carlos-story.jpg,testimonial-fan-wearing.jpg,testimonial-fan-smoove.jpg' | split: ','
  assign proof_captions = 'Fan showing off their athlete drop,Real fan merch in the wild,Customer love from Instagram,Fan repping their athlete tee,Story repost from a happy buyer' | split: ','
-%}
<section class="testimonials" id="reviews">
  <div class="page-width reveal">
    <div class="section-intro section-intro--center">
      <p class="section-label">{{ section.settings.label }}</p>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}<p class="lede">{{ section.settings.intro }}</p>{% endif %}
    </div>

    <div class="proof-photos-marquee" data-proof-marquee aria-label="Real fan photos">
      <div class="proof-photos-track">
        {%- for proof_image in proof_images -%}
          {%- assign idx = forloop.index0 -%}
          <figure class="proof-photo-card">
            <img
              src="{{ proof_image | asset_url }}"
              alt="{{ proof_captions[idx] | default: 'Teknotize fan photo' | escape }}"
              width="420"
              height="560"
              loading="lazy"
              decoding="async"
            >
          </figure>
        {%- endfor -%}
        {%- for proof_image in proof_images -%}
          {%- assign idx = forloop.index0 -%}
          <figure class="proof-photo-card" aria-hidden="true">
            <img
              src="{{ proof_image | asset_url }}"
              alt=""
              width="420"
              height="560"
              loading="lazy"
              decoding="async"
            >
          </figure>
        {%- endfor -%}
      </div>
    </div>

    <div class="reviews-marquee" data-reviews-marquee aria-label="Customer testimonials">
      <div class="reviews-track">
        {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <article class="review-card crystal" {{ block.shopify_attributes }}>
            <div class="review-head">
              <span class="review-avatar">{{ block.settings.initials | default: block.settings.author | slice: 0, 2 | upcase }}</span>
              <div class="review-meta">
                <strong>{{ block.settings.author }}</strong>
                {% if block.settings.role != blank %}<span class="review-role">{{ block.settings.role }}</span>{% endif %}
              </div>
            </div>
            <div class="stars" aria-hidden="true">★★★★★</div>
            <p>{{ block.settings.quote }}</p>
          </article>
        {% endfor %}
        {% for block in section.blocks %}
          <article class="review-card crystal" aria-hidden="true">
            <div class="review-head">
              <span class="review-avatar">{{ block.settings.initials | default: block.settings.author | slice: 0, 2 | upcase }}</span>
              <div class="review-meta">
                <strong>{{ block.settings.author }}</strong>
                {% if block.settings.role != blank %}<span class="review-role">{{ block.settings.role }}</span>{% endif %}
              </div>
            </div>
            <div class="stars">★★★★★</div>
            <p>{{ block.settings.quote }}</p>
          </article>
        {% endfor %}
        {% else %}
          <article class="review-card crystal"><div class="review-head"><span class="review-avatar">JM</span><div class="review-meta"><strong>Jordan M.</strong><span class="review-role">D1 Basketball · Athlete</span></div></div><div class="stars" aria-hidden="true">★★★★★</div><p>My store went live in a week. First drop sold out in 3 days. The hoodie quality is insane and fans keep asking when the next one drops.</p></article>
          <article class="review-card crystal"><div class="review-head"><span class="review-avatar">SR</span><div class="review-meta"><strong>Sarah R.</strong><span class="review-role">Fan · Verified Buyer</span></div></div><div class="stars" aria-hidden="true">★★★★★</div><p>Ordered a boxy tee from my favorite athlete's store. Fit is perfect, fabric feels premium, and it shipped faster than I expected.</p></article>
          <article class="review-card crystal"><div class="review-head"><span class="review-avatar">DK</span><div class="review-meta"><strong>Darius K.</strong><span class="review-role">High School Football · Athlete</span></div></div><div class="stars" aria-hidden="true">★★★★★</div><p>I didn't think anyone would buy merch from a high school player. Teknotize proved me wrong. My whole team wants stores now.</p></article>
          <article class="review-card crystal"><div class="review-head"><span class="review-avatar">AL</span><div class="review-meta"><strong>Amanda L.</strong><span class="review-role">NIL Agency Partner</span></div></div><div class="stars" aria-hidden="true">★★★★★</div><p>We onboarded 30 athletes in one month. The ops team handles everything. Our clients just share their link and collect.</p></article>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Real Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the Locker Room & the Stands" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Athletes who sell with us. Fans who shop with us." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "role", "label": "Role", "default": "Athlete" },
        { "type": "text", "id": "initials", "label": "Initials", "default": "TM" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
