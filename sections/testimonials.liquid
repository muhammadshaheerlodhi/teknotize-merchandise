<section class="testimonials" id="reviews">
  <div class="page-width reveal">
    <div class="section-intro section-intro--center">
      <p class="section-label">{{ section.settings.label }}</p>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}<p class="lede">{{ section.settings.intro }}</p>{% endif %}
    </div>
    <div class="reviews-marquee" data-reviews-marquee aria-label="Customer testimonials">
      <div class="reviews-track">
        {% for block in section.blocks %}
          <article class="review-card crystal" {{ block.shopify_attributes }}>
            <div class="review-head">
              <span class="review-avatar">{{ block.settings.initials | default: block.settings.author | slice: 0, 2 | upcase }}</span>
              <div class="review-meta">
                <strong>{{ block.settings.author }}</strong>
                {% if block.settings.role != blank %}<span class="review-role">{{ block.settings.role }}</span>{% endif %}
              </div>
            </div>
            <div class="stars" aria-hidden="true">★★★★★</div>
            <p>{{ block.settings.quote }}</p>
          </article>
        {% endfor %}
        {% for block in section.blocks %}
          <article class="review-card crystal" aria-hidden="true">
            <div class="review-head">
              <span class="review-avatar">{{ block.settings.initials | default: block.settings.author | slice: 0, 2 | upcase }}</span>
              <div class="review-meta">
                <strong>{{ block.settings.author }}</strong>
                {% if block.settings.role != blank %}<span class="review-role">{{ block.settings.role }}</span>{% endif %}
              </div>
            </div>
            <div class="stars">★★★★★</div>
            <p>{{ block.settings.quote }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Real Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the Locker Room & the Stands" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Athletes who sell with us. Fans who shop with us." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "role", "label": "Role", "default": "Athlete" },
        { "type": "text", "id": "initials", "label": "Initials", "default": "TM" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
