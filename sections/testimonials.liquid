<section class="testimonials" id="reviews">
  <div class="page-width reveal">
    <div class="section-intro section-intro--center">
      <p class="section-label">{{ section.settings.label }}</p>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}<p class="lede">{{ section.settings.intro }}</p>{% endif %}
    </div>

    {% render 'proof-media-marquee', section: section %}

    <div class="reviews-marquee" data-reviews-marquee aria-label="Customer testimonials">
      <div class="reviews-track">
        {% assign has_reviews = false %}
        {% for block in section.blocks %}
          {% if block.type == 'review' and block.settings.quote != blank %}
            {% assign has_reviews = true %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if has_reviews %}
          {% for pass in (1..2) %}
            {% for block in section.blocks %}
              {% if block.type != 'review' or block.settings.quote == blank %}{% continue %}{% endif %}
              {% assign review_name = block.settings.name | default: block.settings.author %}
              {% assign rating = block.settings.rating | default: 5 %}
              <article class="review-card crystal"{% if pass == 2 %} aria-hidden="true"{% endif %}{% if pass == 1 %} {{ block.shopify_attributes }}{% endif %}>
                <div class="review-head">
                  <span class="review-avatar">{{ block.settings.initials | default: review_name | slice: 0, 2 | upcase }}</span>
                  <div class="review-meta">
                    <strong>{{ review_name }}</strong>
                    {% if block.settings.role != blank %}<span class="review-role">{{ block.settings.role }}</span>{% endif %}
                  </div>
                </div>
                <div class="stars" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    {%- if i <= rating -%}★{%- else -%}☆{%- endif -%}
                  {%- endfor -%}
                </div>
                <p>{{ block.settings.quote }}</p>
                {% if block.settings.store_link != blank %}
                  <a class="review-role" href="{{ block.settings.store_link }}" style="display:inline-block;margin-top:4px;">Shop their store →</a>
                {% endif %}
              </article>
            {% endfor %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Real Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the Locker Room & the Stands" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Athletes who sell with us. Fans who shop with us." },
    { "type": "video", "id": "proof_video_1", "label": "Proof video 1" },
    { "type": "video", "id": "proof_video_2", "label": "Proof video 2" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role line", "default": "Athlete" },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Star rating", "default": 5 },
        { "type": "url", "id": "store_link", "label": "Store link" },
        { "type": "text", "id": "initials", "label": "Initials (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
