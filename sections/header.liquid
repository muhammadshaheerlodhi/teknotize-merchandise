{%- liquid
  assign store_url = settings.athlete_store_url | default: routes.collections_url
  if store_url == blank or store_url == 'shopify://collections' or store_url contains '/collections/all'
    assign store_url = routes.collections_url | default: '/collections'
  endif
  assign signup_url = settings.signup_url | default: 'https://docs.google.com/forms/d/e/1FAIpQLSfAybgtsOEkqdrP2hBMclujWAbKl5xVkAE4lx4TDgwMzffNlQ/viewform'
  if signup_url == blank or signup_url contains '/pages/signup'
    assign signup_url = 'https://docs.google.com/forms/d/e/1FAIpQLSfAybgtsOEkqdrP2hBMclujWAbKl5xVkAE4lx4TDgwMzffNlQ/viewform'
  endif
  assign agency_url = settings.agency_url | default: 'https://docs.google.com/forms/d/e/1FAIpQLSeHk1xJDML2hD0uBmKdL0uFBV7Kc1W9t1bvXFb55sO_LllfvQ/viewform'
  if agency_url == blank or agency_url contains '/pages/agency'
    assign agency_url = 'https://docs.google.com/forms/d/e/1FAIpQLSeHk1xJDML2hD0uBmKdL0uFBV7Kc1W9t1bvXFb55sO_LllfvQ/viewform'
  endif
  assign home_url = routes.root_url | default: '/'
  if home_url == blank
    assign home_url = '/'
  endif
  assign contact_url = pages.contact.url | default: '/pages/contact'
  if contact_url == blank
    assign contact_url = '/pages/contact'
  endif
-%}
<header class="site-header">
  <div class="page-width header-inner">
    <div class="header-brand">
      <button class="icon-btn menu-toggle" type="button" data-menu-toggle aria-label="Menu">☰</button>
      {% render 'logo', class: 'header-logo' %}
    </div>

    <nav class="header-nav" aria-label="Primary" data-scroll-nav>
      <a href="{{ home_url }}">Home</a>
      <a href="{{ store_url }}">Athlete Store</a>
      <a href="{{ home_url }}#why-teknotize">About Us</a>
      <a href="{{ home_url }}#reviews">Reviews</a>
      <a href="{{ contact_url }}">Contact</a>
      <a href="{{ signup_url }}" target="_blank" rel="noopener">Athlete Merch Sign-up</a>
    </nav>

    <div class="header-actions">
      <a href="{{ signup_url }}" class="btn btn-primary header-signup desktop-only" target="_blank" rel="noopener">Sign Up</a>
      <a class="icon-btn" href="{{ routes.search_url }}" data-open-search aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg>
      </a>
      <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-4 6-6 8-6s6.5 2 8 6"/></svg>
      </a>
      <a class="icon-btn" href="{{ routes.cart_url }}" data-open-cart aria-label="Cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6L5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
        <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    }
  ]
}
{% endschema %}
