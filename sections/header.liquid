{% render 'site-urls' %}



<header class="site-header">

  <div class="page-width header-inner">

    <div class="header-brand">

      <button class="icon-btn menu-toggle" type="button" data-menu-toggle aria-label="Menu">☰</button>

      {% render 'logo', class: 'header-logo' %}

    </div>



    <nav class="header-nav" aria-label="Primary" data-scroll-nav>
      <a href="{{ routes.root_url }}#home"{% if template.name == 'index' %} class="is-active"{% endif %}>Home</a>
      <a href="{{ store_url }}">Athlete Store</a>
      <a href="{{ routes.root_url }}#why-teknotize">About</a>
      <a href="{{ routes.root_url }}#how-it-works">How It Works</a>
      <a href="{{ routes.root_url }}#reviews">Reviews</a>
      <a href="{{ routes.root_url }}#contact">Contact</a>
      <a href="{{ routes.root_url }}#partnerships">Partnerships</a>
    </nav>



    <div class="header-actions">

      <a href="{{ signup_url }}" class="btn btn-primary header-signup desktop-only" target="_blank" rel="noopener">Sign Up</a>

      <a class="icon-btn" href="{{ routes.search_url }}" data-open-search aria-label="Search">

        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg>

      </a>

      <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">

        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-4 6-6 8-6s6.5 2 8 6"/></svg>

      </a>

      <a class="icon-btn" href="{{ routes.cart_url }}" data-open-cart aria-label="Cart">

        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6L5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>

        <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>

      </a>

      <a href="{{ signup_url }}" class="btn btn-primary header-signup mobile-only" target="_blank" rel="noopener">Sign Up</a>

    </div>

  </div>



  <nav class="mobile-drawer" data-mobile-drawer aria-label="Mobile">

    <a href="{{ routes.root_url }}#home">Home</a>
    <a href="{{ store_url }}">Athlete Store</a>
    <a href="{{ routes.root_url }}#why-teknotize">About</a>
    <a href="{{ routes.root_url }}#how-it-works">How It Works</a>
    <a href="{{ routes.root_url }}#reviews">Reviews</a>
    <a href="{{ routes.root_url }}#contact">Contact</a>
    <a href="{{ routes.root_url }}#partnerships">Partnerships</a>

    <a href="{{ signup_url }}" target="_blank" rel="noopener">Athlete Sign Up</a>

    <a href="{{ agency_url }}" target="_blank" rel="noopener">Become An NIL Agency</a>

  </nav>

</header>



{% schema %}

{

  "name": "Header",

  "settings": [

    {

      "type": "checkbox",

      "id": "sticky",

      "label": "Sticky header",

      "default": true

    }

  ]

}

{% endschema %}

