{%- liquid
  assign drops_collection = section.settings.collection
  if drops_collection == blank or drops_collection.products_count == 0
    assign drops_collection = collections.all
  endif
  assign product_limit = section.settings.products_to_show | default: 6
  assign btn_link = section.settings.button_link | default: routes.all_products_collection_url
  if btn_link == blank
    assign btn_link = '/collections/all'
  endif
  assign seen_athletes = '||'
  assign seen_buckets = '||'
  assign shown = 0
  assign delim = '||'
-%}
<section class="trending-drops" id="trending-drops">
  <div class="page-width reveal">
    <div class="section-intro section-intro--center">
      <p class="eyebrow">{{ section.settings.eyebrow | default: 'Fan Favorites' }}</p>
      <h2 class="section-title">{{ section.settings.heading | default: 'Top Trending Drops' }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="lede">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="trending-drops__grid product-grid">
      {%- comment -%} One drop per athlete store — up to 6 mixed product types {%- endcomment -%}
      {%- assign athlete_stores = collections | sort: 'published_at' | reverse -%}
      {%- for athlete_store in athlete_stores -%}
        {%- if shown >= product_limit -%}{%- break -%}{%- endif -%}
        {%- assign store_handle = athlete_store.handle | downcase -%}
        {%- if store_handle == 'all' or store_handle == 'frontpage' or store_handle == 'products' -%}{%- continue -%}{%- endif -%}
        {%- if athlete_store.products_count == 0 -%}{%- continue -%}{%- endif -%}

        {%- assign picked_product = blank -%}
        {%- for product in athlete_store.products -%}
          {%- assign title_l = product.title | downcase -%}
          {%- assign bucket = 'drop' -%}
          {%- if title_l contains 'kid' -%}
            {%- assign bucket = 'kids' -%}
          {%- elsif title_l contains 'hoodie' -%}
            {%- assign bucket = 'hoodie' -%}
          {%- elsif title_l contains 'sweatshirt' -%}
            {%- assign bucket = 'sweatshirt' -%}
          {%- elsif title_l contains 'fleece' -%}
            {%- assign bucket = 'fleece' -%}
          {%- elsif title_l contains 'washed' -%}
            {%- assign bucket = 'washed' -%}
          {%- elsif title_l contains 'boxy' or title_l contains ' tee' or title_l contains '-tee' -%}
            {%- assign bucket = 'tee' -%}
          {%- endif -%}
          {%- assign bucket_token = delim | append: bucket | append: delim -%}
          {%- if seen_buckets contains bucket_token -%}{%- continue -%}{%- endif -%}
          {%- assign picked_product = product -%}
          {%- break -%}
        {%- endfor -%}
        {%- if picked_product == blank -%}
          {%- assign picked_product = athlete_store.products.first -%}
        {%- endif -%}
        {%- if picked_product == blank -%}{%- continue -%}{%- endif -%}

        {%- assign title_l = picked_product.title | downcase -%}
        {%- assign bucket = 'drop' -%}
        {%- if title_l contains 'kid' -%}
          {%- assign bucket = 'kids' -%}
        {%- elsif title_l contains 'hoodie' -%}
          {%- assign bucket = 'hoodie' -%}
        {%- elsif title_l contains 'sweatshirt' -%}
          {%- assign bucket = 'sweatshirt' -%}
        {%- elsif title_l contains 'fleece' -%}
          {%- assign bucket = 'fleece' -%}
        {%- elsif title_l contains 'washed' -%}
          {%- assign bucket = 'washed' -%}
        {%- elsif title_l contains 'boxy' or title_l contains ' tee' or title_l contains '-tee' -%}
          {%- assign bucket = 'tee' -%}
        {%- endif -%}
        {%- assign seen_buckets = seen_buckets | append: bucket | append: delim -%}
        {%- assign seen_athletes = seen_athletes | append: store_handle | append: delim -%}
        {%- assign shown = shown | plus: 1 -%}
        {% render 'trending-drop-card', product: picked_product %}
      {%- endfor -%}

      {%- if shown < product_limit -%}
        {%- for product in drops_collection.products -%}
          {%- if shown >= product_limit -%}{%- break -%}{%- endif -%}
          {%- assign athlete_key = '' -%}
          {%- for athlete_collection in product.collections -%}
            {%- assign inner_handle = athlete_collection.handle | downcase -%}
            {%- if inner_handle == 'all' or inner_handle == 'frontpage' or inner_handle == 'products' -%}{%- continue -%}{%- endif -%}
            {%- assign athlete_key = inner_handle -%}
            {%- break -%}
          {%- endfor -%}
          {%- if athlete_key == blank -%}{%- assign athlete_key = product.vendor | handleize -%}{%- endif -%}
          {%- if athlete_key == blank -%}{%- assign athlete_key = product.id -%}{%- endif -%}
          {%- assign athlete_token = delim | append: athlete_key | append: delim -%}
          {%- if seen_athletes contains athlete_token -%}{%- continue -%}{%- endif -%}
          {%- assign seen_athletes = seen_athletes | append: athlete_key | append: delim -%}
          {%- assign shown = shown | plus: 1 -%}
          {% render 'trending-drop-card', product: product %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="trending-drops__cta">
      <a class="btn btn-primary" href="{{ btn_link }}">{{ section.settings.button_label | default: 'Shop All Products' }}</a>
    </div>
  </div>
</section>

{% stylesheet %}
.trending-drops {
  padding: var(--tm-section-py) 0;
}

.trending-drops__grid {
  margin-top: var(--tm-space-lg);
}

.trending-drops__media {
  position: relative;
}

.trending-drops__img--hover {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.35s var(--tm-ease);
}

.trending-drops__card:hover .trending-drops__img--hover {
  opacity: 1;
}

.trending-drops__card:hover .trending-drops__img--primary {
  opacity: 0;
}

.trending-drops__img--primary {
  transition: opacity 0.35s var(--tm-ease);
}

.trending-drops__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 2;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #fff;
  background: rgba(17, 17, 17, 0.82);
}

.trending-drops__vendor {
  margin: 4px 0 8px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--tm-accent);
}

.trending-drops__cta {
  display: flex;
  justify-content: center;
  margin-top: var(--tm-space-xl);
}

@media (max-width: 990px) {
  .trending-drops__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .trending-drops__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: visible;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Trending drops",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fan Favorites" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Top Trending Drops" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The hoodies and tees fans are copping right now." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Use a store-wide collection sorted by best selling. The section shows one item per athlete and mixes hoodies, sweatshirts, tees, and kids styles when possible." },
    { "type": "range", "id": "products_to_show", "min": 3, "max": 12, "step": 1, "label": "Number of products", "default": 6 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop All Products" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/collections/all" }
  ],
  "presets": [{ "name": "Trending drops" }]
}
{% endschema %}
