<section class="hero">
  <div class="page-width">
    <div class="hero-grid{% unless section.settings.image != blank %} hero-grid--single{% endunless %}">
      <div class="hero-content">
        {%- if section.settings.badge_text != blank -%}
          <span class="eyebrow">{{ section.settings.badge_text }}</span>
        {%- endif -%}
        {%- if section.settings.kicker != blank -%}
          <p class="section-label">{{ section.settings.kicker }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1>{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.copy != blank -%}
          <p class="hero-copy">{{ section.settings.copy }}</p>
        {%- endif -%}
        {%- if section.settings.copy_2 != blank -%}
          <p class="hero-copy">{{ section.settings.copy_2 }}</p>
        {%- endif -%}

        <div class="hero-actions">
          {%- if section.settings.cta_primary != blank -%}
            <a href="{{ section.settings.cta_primary_link | default: '#' }}" class="btn btn-primary">
              {{ section.settings.cta_primary }}
            </a>
          {%- endif -%}
          {%- if section.settings.cta_secondary != blank -%}
            <a href="{{ section.settings.cta_secondary_link | default: '#' }}" class="btn btn-ghost">
              {{ section.settings.cta_secondary }}
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.float_text != blank -%}
          <p class="stat-live">
            <span class="live-dot"></span>{{ section.settings.float_text }}
          </p>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div class="hero-media">
          <div class="hero-image-frame crystal">
            {{
              section.settings.image
              | image_url: width: 800
              | image_tag:
                class: 'hero-art-img',
                loading: 'eager',
                widths: '400,600,800',
                sizes: '(min-width: 980px) 380px, 80vw'
            }}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge text" },
    { "type": "text", "id": "kicker", "label": "Kicker text" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "copy", "label": "Copy" },
    { "type": "textarea", "id": "copy_2", "label": "Secondary copy" },
    { "type": "text", "id": "cta_primary", "label": "Primary button label" },
    { "type": "url", "id": "cta_primary_link", "label": "Primary button link" },
    { "type": "text", "id": "cta_secondary", "label": "Secondary button label" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary button link" },
    { "type": "text", "id": "float_text", "label": "Floating stat text" },
    { "type": "image_picker", "id": "image", "label": "Hero image (optional)" }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}