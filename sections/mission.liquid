<section class="mission" id="why-teknotize">
  <div class="page-width reveal">
    <div class="section-intro section-intro--center">
      <p class="section-label">{{ section.settings.label }}</p>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.copy }}</p>
      {% if section.settings.copy_2 != blank %}<p class="lede">{{ section.settings.copy_2 }}</p>{% endif %}
    </div>
    <div class="orbit-cards reveal-stagger">
      {% assign orbit_fallbacks = 'orbit-merch-camera.png,hero-athlete.jpg,orbit-custom-graphics.png,orbit-print-pack.png,orbit-premium-blanks.png,orbit-scale-up.png' | split: ',' %}
      {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% assign idx = forloop.index0 %}
        <article class="orbit-card crystal" tabindex="0" {{ block.shopify_attributes }}>
          <div class="orbit-card-media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              <img src="{{ orbit_fallbacks[idx] | default: 'stores-athlete.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="400" height="400">
            {%- endif -%}
          </div>
          <div class="orbit-card-body">
            <h3>{{ block.settings.title }}</h3>
            <p class="orbit-desc">{{ block.settings.copy }}</p>
          </div>
        </article>
      {% endfor %}
      {% else %}
        <article class="orbit-card crystal" tabindex="0"><div class="orbit-card-media"><img src="{{ 'orbit-merch-camera.png' | asset_url }}" alt="Merch That Looks Fire on Camera" loading="lazy" width="400" height="400"></div><div class="orbit-card-body"><h3>Merch That Looks Fire on Camera</h3><p class="orbit-desc">Designed for social, built for the stands. Your drop will look as good in a TikTok as it does in person.</p></div></article>
        <article class="orbit-card crystal" tabindex="0"><div class="orbit-card-media"><img src="{{ 'hero-athlete.jpg' | asset_url }}" alt="Built to Convert Followers" loading="lazy" width="400" height="400"></div><div class="orbit-card-body"><h3>Built to Convert Followers</h3><p class="orbit-desc">Clean layouts, fast checkout, mobile-first design because most of your fans are buying from their phone.</p></div></article>
        <article class="orbit-card crystal" tabindex="0"><div class="orbit-card-media"><img src="{{ 'orbit-custom-graphics.png' | asset_url }}" alt="Custom Graphics On Demand" loading="lazy" width="400" height="400"></div><div class="orbit-card-body"><h3>Custom Graphics On Demand</h3><p class="orbit-desc">Our artists build around your brand: colors, fonts, logos, and layouts that feel authentically you.</p></div></article>
        <article class="orbit-card crystal" tabindex="0"><div class="orbit-card-media"><img src="{{ 'orbit-print-pack.png' | asset_url }}" alt="We Print, Pack & Ship Everything" loading="lazy" width="400" height="400"></div><div class="orbit-card-body"><h3>We Print, Pack & Ship Everything</h3><p class="orbit-desc">Production partners, quality control, and worldwide shipping handled end-to-end so you never touch a box.</p></div></article>
        <article class="orbit-card crystal" tabindex="0"><div class="orbit-card-media"><img src="{{ 'orbit-premium-blanks.png' | asset_url }}" alt="Premium Blanks Only" loading="lazy" width="400" height="400"></div><div class="orbit-card-body"><h3>Premium Blanks Only</h3><p class="orbit-desc">Oversized hoodies, heavyweight boxy tees, fleece sweatshirts. Fabrics that feel expensive because they are.</p></div></article>
        <article class="orbit-card crystal" tabindex="0"><div class="orbit-card-media"><img src="{{ 'orbit-scale-up.png' | asset_url }}" alt="Scale As You Blow Up" loading="lazy" width="400" height="400"></div><div class="orbit-card-body"><h3>Scale As You Blow Up</h3><p class="orbit-desc">More products, bigger drops, team deals, and agency partnerships. We grow when you grow.</p></div></article>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mission",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "The Advantage" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Everything You Need to Win Off the Field" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "We built the full stack so athletes can monetize their brand without becoming a business major." },
    { "type": "textarea", "id": "copy_2", "label": "Copy 2", "default": "" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon emoji" },
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "copy", "label": "Copy" },
        { "type": "image_picker", "id": "image", "label": "Card image" }
      ]
    }
  ],
  "presets": [{ "name": "Mission" }]
}
{% endschema %}
