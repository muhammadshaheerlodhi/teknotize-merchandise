<section class="password-wrap">
  {% render 'logo', class: 'password-logo' %}
  <p class="eyebrow">Coming soon</p>
  <h1>Teknotize Merchandise</h1>
  <p class="lede">Premium athlete apparel is almost live. Enter the store password to preview.</p>
  {% form 'storefront_password', class: 'password-form' %}
    <input type="password" name="password" placeholder="Store password" aria-label="Password">
    <button type="submit" class="btn btn-primary">Enter store</button>
    {% if form.errors %}
      <p class="form-error">{{ form.errors | default_errors }}</p>
    {% endif %}
  {% endform %}
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
